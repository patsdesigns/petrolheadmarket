---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  /** Public pages (the Lot, car pages) may be indexed; account pages never. */
  index?: boolean;
  /** Share image (absolute or site path), for public pages. */
  image?: string | null;
}

const { title, description = "Buy and sell enthusiast cars. Every listing reviewed by a person.", index = false, image = null } =
  Astro.props;
const shareImage = image ? new URL(image, Astro.url).toString() : null;
const fullTitle = title ? `${title} | Petrol Head Market` : "Petrol Head Market";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={index ? "index, follow" : "noindex"} />
    {index && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.url).toString()} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="theme-color" content="#EEF0F3" />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800;900&family=IBM+Plex+Mono:wght@400;600&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header user={Astro.locals.profile ? { displayName: Astro.locals.profile.displayName, isAdmin: Astro.locals.profile.role === "admin" } : null} unread={Astro.locals.unread} adminTodo={Astro.locals.adminCounts ? Astro.locals.adminCounts.review + Astro.locals.adminCounts.contact + Astro.locals.adminCounts.flags : 0} />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-foot">Petrol Head Market · Every listing vetted by a person · Enthusiast cars only</footer>
  </body>
</html>
