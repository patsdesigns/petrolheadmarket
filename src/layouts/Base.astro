---
import { SITE_NAME } from "../lib/brand";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { url } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
  /** Public pages (the Lot, car pages) may be indexed; account pages never. */
  index?: boolean;
  /** Share image (absolute or site path), for public pages. */
  image?: string | null;
}

const { title, description = "Buy and sell enthusiast cars. Every listing reviewed by a person.", index = false, image = null } =
  Astro.props;
const shareImage = image ? new URL(image, Astro.url).toString() : null;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={index ? "index, follow" : "noindex"} />
    {index && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.url).toString()} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="theme-color" content="#EEF0F3" />
    <!-- Theme before first paint: the visitor's choice, else the system setting. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var media = window.matchMedia("(prefers-color-scheme: dark)");
        var apply = function () {
          var dark = stored === "dark" || (stored !== "light" && media.matches);
          document.documentElement.dataset.theme = dark ? "dark" : "light";
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", dark ? "#0E1013" : "#EEF0F3");
        };
        apply();
        media.addEventListener("change", function () {
          try {
            stored = localStorage.getItem("theme");
          } catch (e) {}
          apply();
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <!-- Hover prefetch: the browser fetches a page when the pointer rests on
         its link, so the click opens it at once. Never sign out links, the
         API, or threads (opening one marks it read). -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [{
        where: { and: [
          { href_matches: "/*" },
          { not: { href_matches: "/logout" } },
          { not: { href_matches: "/api/*" } },
          { not: { href_matches: "/inbox/*" } },
          { not: { href_matches: "/photos/*" } },
          { not: { selector_matches: "[data-no-prefetch]" } },
        ] },
        eagerness: "moderate",
      }],
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@500;600;700;800&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header user={Astro.locals.profile ? { displayName: Astro.locals.profile.displayName, isAdmin: Astro.locals.profile.role === "admin" } : null} unread={Astro.locals.unread} adminTodo={Astro.locals.adminCounts ? Astro.locals.adminCounts.review + Astro.locals.adminCounts.contact + Astro.locals.adminCounts.flags : 0} />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-foot">
      <nav class="site-foot__links" aria-label="Site">
        <a href={url("/")}>The Lot</a>
        <a href={url("/how-it-works")}>How It Works</a>
        <a href={url("/sell")}>Sell Your Car</a>
        <a href={url("/contact")}>Contact the Team</a>
      </nav>
      <p>{SITE_NAME} · Every listing vetted by a person · Enthusiast cars only</p>
    </footer>
  </body>
</html>
