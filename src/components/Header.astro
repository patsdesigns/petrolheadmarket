---
import { SITE_INITIALS, SITE_NAME, SITE_TAGLINE } from "../lib/brand";
// Light glass site header, shared by every page. The red promise strip was removed at the owner's request.
import { url, siteUrl, GARAGE } from "../lib/paths";

interface Props {
  user?: { displayName: string; isAdmin: boolean } | null;
  unread?: number;
  /** Admins only: listings to review, open contact requests and unreviewed flags. */
  adminTodo?: number;
}

const { user = null, unread = 0, adminTodo = 0 } = Astro.props;
const path = Astro.url.pathname;
// On the Lot the search box belongs to the Lot's own form (form="lot"), so a
// search keeps the filters that are set. Everywhere else it opens the Lot.
const onLot = path === url("/");
const q = onLot ? (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80) : "";
const here = (p: string) => (p === url(GARAGE) ? path === p : path.startsWith(p));
---

<div class="top">
  <header class="mast">
    <div class="mast__inner">
      <a class="brand" href={siteUrl("/")}>
        <span class="roundel" aria-hidden="true">{SITE_INITIALS}</span>
        <span class="wordmark">
          {SITE_NAME}
          <span class="wordmark__sub">{SITE_TAGLINE}</span>
        </span>
      </a>
      <form class="hsearch" method="get" action={url("/")} role="search">
        <label class="sr-only" for="site-q">Search cars</label>
        <input
          id="site-q"
          name="q"
          type="search"
          value={q}
          maxlength="80"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          placeholder="Search make, model, year or city"
          form={onLot ? "lot" : undefined}
        />
        <button class="hsearch__go" type="submit" form={onLot ? "lot" : undefined} aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4"></circle><path
              d="M20 20l-4-4"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"></path></svg
          >
        </button>
      </form>
      <nav class="actions" aria-label="Account">
        {
          user ? (
            <>
              <a class="ghost" href={url(GARAGE)} aria-current={here(url(GARAGE)) ? "page" : undefined}>My garage</a>
              <a class="ghost" href={url("/inbox")} aria-current={here(url("/inbox")) ? "page" : undefined}>
                Inbox
                {unread > 0 && (
                  <span class="count" aria-label={`${unread} unread`}>{unread}</span>
                )}
              </a>
              <details class="menu">
                <summary class="ghost" title={user.displayName}>
                  <span class="menu__name">{user.displayName}</span>
                  {user.isAdmin && adminTodo > 0 && (
                    <span class="count" aria-label={`${adminTodo} waiting for an admin`}>{adminTodo}</span>
                  )}
                  <span aria-hidden="true" class="menu__caret">▾</span>
                </summary>
                <div class="menu__panel">
                  <a href={url("/account")}>Account settings</a>
                  <a href={url("/offers")}>Offers</a>
                  {user.isAdmin && (
                    <a href={url("/admin")}>
                      Review queue
                      {adminTodo > 0 && <span class="count" aria-label={`${adminTodo} waiting`}>{adminTodo}</span>}
                    </a>
                  )}
                  <form method="post" action={url("/logout")}>
                    <button type="submit">Sign out</button>
                  </form>
                </div>
              </details>
            </>
          ) : (
            <a class="ghost" href={url("/login")}>Sign in</a>
          )
        }
        <a class="sell" href={url("/sell")}>
          <span class="sell-long">Sell your car</span><span class="sell-short">Sell</span>
        </a>
      </nav>
    </div>
  </header>
</div>

<script>
  // "/" jumps to the search box from anywhere on the site.
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
    e.preventDefault();
    document.getElementById("site-q")?.focus();
  });
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .mast {
    position: relative;
    color: var(--ink);
    font-family: var(--font-ui);
    border-bottom: 1px solid rgba(21, 23, 27, 0.06);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 6px 20px rgba(21, 23, 27, 0.04);
  }
  /* The blur sits on a layer behind the bar, so the account menu inside can
     blur the page with its own backdrop filter. */
  .mast::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--glass-strong);
    -webkit-backdrop-filter: var(--glass-blur-strong);
    backdrop-filter: var(--glass-blur-strong);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .mast::before {
      background: rgba(255, 255, 255, 0.94);
    }
  }
  .mast__inner {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: var(--header-h);
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 10px var(--gutter);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
    border-radius: 10px;
  }
  .roundel {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border: 3px solid var(--red);
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-head);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 6px rgba(21, 23, 27, 0.1);
  }
  .wordmark {
    font-family: var(--font-head);
    font-size: 19px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .wordmark__sub {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: none;
  }
  /* Search: a glass pill in the middle of the bar. */
  .hsearch {
    position: relative;
    flex: 1 1 auto;
    max-width: 560px;
    min-width: 0;
    margin: 0 auto;
  }
  .hsearch input {
    width: 100%;
    height: 44px;
    padding: 0 52px 0 18px;
    border: 1px solid rgba(21, 23, 27, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    color: var(--ink);
    font: 500 15.5px var(--font-ui);
    outline: 0;
    box-shadow: 0 1px 2px rgba(21, 23, 27, 0.04) inset;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }
  .hsearch input::placeholder {
    color: #7a7e86;
  }
  .hsearch input:hover {
    background: rgba(255, 255, 255, 0.95);
  }
  .hsearch input:focus {
    background: var(--white);
    border-color: var(--red);
    box-shadow: 0 0 0 4px rgba(213, 0, 28, 0.14);
  }
  .hsearch input::-webkit-search-cancel-button {
    cursor: pointer;
  }
  .hsearch__go {
    position: absolute;
    right: 4px;
    top: 4px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .hsearch__go:hover {
    background: var(--red);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid rgba(21, 23, 27, 0.12);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.7);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .ghost:hover {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(21, 23, 27, 0.22);
  }
  .ghost[aria-current="page"] {
    background: var(--white);
    border-color: rgba(21, 23, 27, 0.28);
  }
  .sell {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 10px;
    background: var(--red);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(213, 0, 28, 0.22);
    transition: background-color 0.15s ease;
  }
  .sell:hover {
    background: var(--red-dark);
  }
  .sell-short {
    display: none;
  }
  .count {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--red);
    color: var(--white);
    font-family: var(--font-label);
    font-size: 10.5px;
    font-weight: 600;
  }
  .menu {
    position: relative;
  }
  .menu__panel .count {
    margin-left: auto;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu__caret {
    font-size: 11px;
    color: var(--muted);
  }
  /* Long display names are cut short so the bar never overflows. */
  .menu__name {
    display: inline-block;
    max-width: 16ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
  .menu,
  .menu summary {
    min-width: 0;
  }
  .menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    z-index: 60;
    min-width: 220px;
    display: grid;
    padding: 6px;
    background: var(--glass-strong);
    -webkit-backdrop-filter: var(--glass-blur-strong);
    backdrop-filter: var(--glass-blur-strong);
    color: var(--ink);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7) inset, 0 18px 40px rgba(21, 23, 27, 0.16);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .menu__panel {
      background: rgba(255, 255, 255, 0.96);
    }
  }
  .menu__panel a,
  .menu__panel button {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 42px;
    padding: 0 12px;
    border: 0;
    border-radius: 9px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .menu__panel a:hover,
  .menu__panel button:hover {
    background: rgba(21, 23, 27, 0.05);
  }
  .menu__panel form {
    margin: 4px 0 0;
    padding-top: 4px;
    border-top: 1px solid var(--hair);
  }

  /* Narrower screens: the search takes its own row under the logo. The
     header stops being sticky on phones so it does not eat the screen. */
  @media (max-width: 860px) {
    .mast__inner {
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .hsearch {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 720px) {
    .top {
      position: static;
    }
  }
  /* Small screens: keep the bar on one line. */
  @media (max-width: 720px) {
    .wordmark__sub {
      display: none;
    }
    .wordmark {
      font-size: 14px;
    }
    .actions {
      gap: 6px;
    }
    .ghost {
      padding: 7px 10px;
    }
    .sell {
      padding: 8px 12px;
    }
    .sell-long {
      display: none;
    }
    .sell-short {
      display: inline;
    }
  }
  @media (max-width: 480px) {
    .mast__inner {
      flex-wrap: wrap;
      row-gap: 8px;
      padding: 10px 16px;
    }
    .ghost {
      padding: 7px 9px;
    }
    .actions {
      width: 100%;
      margin-left: 0;
      flex-wrap: wrap;
      row-gap: 6px;
    }
    .actions .sell {
      margin-left: auto;
    }
    .menu__name {
      max-width: 9ch;
    }
  }
</style>
