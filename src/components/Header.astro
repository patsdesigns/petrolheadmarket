---
import { url, siteUrl } from "../lib/paths";

interface Props {
  /** Signed-in user, once accounts exist (phase 2). */
  user?: { displayName: string; isAdmin: boolean } | null;
  unread?: number;
}

const { user = null, unread = 0 } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={siteUrl("/")}>
      <span class="brand__logo" aria-hidden="true">PH</span>
      <span class="brand__text">
        <span class="brand__name">Petrol Head Market</span>
        <span class="brand__tag">Enthusiast car classifieds</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Account">
      {
        user ? (
          <>
            <a href={url("/")}>My garage</a>
            <a href={url("/inbox")}>
              Inbox
              {unread > 0 && (
                <span class="site-nav__count" aria-label={`${unread} unread`}>
                  {unread}
                </span>
              )}
            </a>
            <details class="menu">
              <summary>
                {user.displayName}
                <span aria-hidden="true" class="menu__caret">▾</span>
              </summary>
              <div class="menu__panel">
                <a href={url("/account")}>Account settings</a>
                <a href={url("/offers")}>Offers</a>
                {user.isAdmin && <a href={url("/admin")}>Review queue</a>}
                <form method="post" action={url("/logout")}>
                  <button type="submit">Sign out</button>
                </form>
              </div>
            </details>
          </>
        ) : (
          <>
            <a href={siteUrl("/")}>Browse cars</a>
            <a href={url("/login")}>Sign in</a>
          </>
        )
      }
      <a class="btn site-nav__sell" href={url("/sell")}>
        <span class="sell-long">Sell your car</span><span class="sell-short">Sell</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--ink);
    color: var(--white);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--white);
  }
  .brand__logo {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 0 0 3px var(--red);
    font-weight: 900;
    font-size: 15px;
    letter-spacing: -0.02em;
  }
  .brand__text {
    display: grid;
    line-height: 1.15;
  }
  .brand__name {
    font-weight: 900;
    font-size: 17px;
  }
  .brand__tag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.65);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 4px 18px;
    flex-wrap: wrap;
  }
  .site-nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
  }
  .site-nav a:not(.btn):hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .menu {
    position: relative;
  }
  .menu summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu__caret {
    font-size: 12px;
  }
  .menu__panel {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    min-width: 200px;
    display: grid;
    padding: 6px;
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(21, 23, 27, 0.15);
  }
  .menu__panel a,
  .menu__panel button {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--tap);
    padding: 0 12px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--ink) !important;
    font: inherit;
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .menu__panel a:hover,
  .menu__panel button:hover {
    background: var(--paper);
    text-decoration: none !important;
  }
  .menu__panel form {
    margin: 0;
    border-top: 1px dashed var(--line);
    padding-top: 4px;
    margin-top: 4px;
  }
  .sell-short {
    display: none;
  }
  @media (max-width: 560px) {
    .site-nav {
      gap: 4px 14px;
    }
    .site-nav__sell {
      padding: 8px 14px;
    }
    .sell-long {
      display: none;
    }
    .sell-short {
      display: inline;
    }
  }
  .site-nav__count {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--red);
    font-family: var(--font-mono);
    font-size: 11px;
  }
</style>
