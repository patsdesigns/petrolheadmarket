---
// The heart: save a car to Saved Cars. A plain form post to /saved (works
// without JavaScript); the script below sends it in the background instead.
// Signed-out visitors get a link to sign in and come back.
import { url } from "../lib/paths";

interface Props {
  listingId: string;
  saved: boolean;
  signedIn: boolean;
  /** "card" is the round heart on a photo, "full" a button with words. */
  variant?: "card" | "full";
}
const { listingId, saved, signedIn, variant = "card" } = Astro.props;
const here = `${Astro.url.pathname}${Astro.url.search}`;
const label = saved ? "Saved" : "Save car";
---

{
  signedIn ? (
    <form class:list={["save", `save--${variant}`]} method="post" action={url("/saved")} data-save>
      <input type="hidden" name="listing" value={listingId} />
      <input type="hidden" name="save" value={saved ? "0" : "1"} />
      <input type="hidden" name="next" value={here} />
      <button type="submit" class="save__btn" aria-pressed={saved ? "true" : "false"} aria-label={variant === "card" ? "Save car" : undefined} title={variant === "card" ? label : undefined}>
        <svg class="save__heart" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.3 0 5.6 3.1 4.4 6.6-1.7 4.8-9.2 9.4-9.2 9.4z" stroke-width="2" stroke-linejoin="round" />
        </svg>
        {variant === "full" && <span class="save__text">{label}</span>}
      </button>
    </form>
  ) : (
    <a class:list={["save", `save--${variant}`, "save__btn"]} href={`${url("/login")}?next=${encodeURIComponent(here)}`} aria-label={variant === "card" ? "Sign in to save this car" : undefined} title={variant === "card" ? "Save car" : undefined}>
      <svg class="save__heart" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 3.9 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.3 0 5.6 3.1 4.4 6.6-1.7 4.8-9.2 9.4-9.2 9.4z" stroke-width="2" stroke-linejoin="round" />
      </svg>
      {variant === "full" && <span class="save__text">Save car</span>}
    </a>
  )
}

<script>
  // Save in the background: flip the heart at once, put it back if the
  // server says no.
  document.addEventListener("submit", async (e) => {
    const form = e.target as HTMLFormElement;
    if (!form.matches?.("[data-save]")) return;
    e.preventDefault();
    const btn = form.querySelector("button") as HTMLButtonElement | null;
    const flag = form.querySelector("input[name=save]") as HTMLInputElement | null;
    const listing = (form.querySelector("input[name=listing]") as HTMLInputElement | null)?.value;
    if (!btn || !flag || !listing || btn.dataset.busy) return;
    const save = flag.value === "1";
    const show = (on: boolean) => {
      btn.setAttribute("aria-pressed", on ? "true" : "false");
      flag.value = on ? "0" : "1";
      const text = btn.querySelector(".save__text");
      if (text) text.textContent = on ? "Saved" : "Save car";
      if (btn.title) btn.title = on ? "Saved" : "Save car";
      // Every heart for this car on the page agrees.
      document.querySelectorAll(`[data-save] input[name=listing][value="${CSS.escape(listing)}"]`).forEach((i) => {
        const f = (i as HTMLInputElement).form;
        if (!f || f === form) return;
        f.querySelector("button")?.setAttribute("aria-pressed", on ? "true" : "false");
        const v = f.querySelector("input[name=save]") as HTMLInputElement | null;
        if (v) v.value = on ? "0" : "1";
        const t = f.querySelector(".save__text");
        if (t) t.textContent = on ? "Saved" : "Save car";
      });
    };
    btn.dataset.busy = "1";
    show(save);
    if (save) {
      btn.classList.remove("pop");
      void btn.offsetWidth;
      btn.classList.add("pop");
    }
    try {
      const res = await fetch(form.action.replace(/\/saved$/, "/api/saved"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ listingId: listing, save }),
      });
      if (res.status === 401) {
        window.location.href = form.action.replace(/\/saved$/, `/login?next=${encodeURIComponent(location.pathname + location.search)}`);
        return;
      }
      const body = (await res.json()) as { saved?: boolean; error?: string };
      if (!res.ok) {
        show(!save);
        if (body.error) alert(body.error);
      }
    } catch {
      show(!save);
    } finally {
      delete btn.dataset.busy;
    }
  });
</script>

<style>
  .save {
    margin: 0;
  }
  .save__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgba(var(--hi-rgb), 0.75);
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .save__heart path {
    fill: transparent;
    stroke: currentColor;
    transition: fill 0.15s ease, stroke 0.15s ease;
  }
  .save__btn[aria-pressed="true"] .save__heart path {
    fill: var(--red);
    stroke: var(--red);
  }
  .save__btn.pop .save__heart {
    animation: heart-pop 0.35s ease-out;
  }
  @keyframes heart-pop {
    40% {
      transform: scale(1.3);
    }
  }
  /* Round glass heart on a photo. */
  .save--card .save__btn,
  .save__btn.save--card {
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: 50%;
    background: rgba(var(--hi-rgb), 0.78);
    -webkit-backdrop-filter: blur(10px) saturate(160%);
    backdrop-filter: blur(10px) saturate(160%);
    box-shadow: 0 4px 12px rgba(21, 23, 27, 0.16);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .save--card .save__btn:hover,
  .save__btn.save--card:hover {
    background: var(--surface);
    transform: scale(1.06);
  }
  /* A full width secondary button (car page). */
  .save--full .save__btn,
  .save__btn.save--full {
    width: 100%;
    min-height: var(--tap);
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-btn);
    background: rgba(var(--hi-rgb), 0.7);
    font: 700 15px var(--font-ui);
  }
  .save--full .save__btn:hover,
  .save__btn.save--full:hover {
    background: var(--surface);
  }
  @media (prefers-reduced-motion: reduce) {
    .save__btn.pop .save__heart {
      animation: none;
    }
  }
</style>
