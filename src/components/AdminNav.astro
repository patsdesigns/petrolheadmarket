---
// Tabs across the top of every admin page.
import { url } from "../lib/paths";

interface Props {
  current: "queue" | "listings" | "users" | "flags" | "contact";
}
const { current } = Astro.props;
const counts = Astro.locals.adminCounts;
const tabs = [
  { key: "queue", label: "Review queue", href: url("/admin"), n: counts?.review ?? 0, what: "waiting for review" },
  { key: "listings", label: "Listings", href: url("/admin/listings"), n: 0, what: "" },
  { key: "users", label: "Users", href: url("/admin/users"), n: 0, what: "" },
  { key: "flags", label: "Flagged", href: url("/admin/flags"), n: counts?.flags ?? 0, what: "not reviewed" },
  { key: "contact", label: "Contact", href: url("/admin/contact"), n: counts?.contact ?? 0, what: "open" },
] as const;
---

<nav class="admin-nav" aria-label="Admin">
  {
    tabs.map((t) => (
      <a href={t.href} aria-current={t.key === current ? "page" : undefined}>
        {t.label}
        {t.n > 0 && <span class="n" aria-label={`${t.n} ${t.what}`}>{t.n}</span>}
      </a>
    ))
  }
</nav>

<style>
  /* A glass pill bar of tabs. */
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 20px;
    padding: 4px;
    border-radius: 14px;
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    font-weight: 700;
    font-size: 15px;
  }
  .admin-nav a {
    color: var(--muted);
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 10px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .admin-nav a:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.6);
  }
  .n {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    margin-left: 6px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--red);
    color: var(--white);
    font-family: var(--font-label);
    font-size: 10.5px;
  }
  .admin-nav a[aria-current] {
    color: var(--ink);
    background: var(--white);
    box-shadow: 0 1px 3px rgba(21, 23, 27, 0.08), inset 0 -2px 0 var(--red);
  }
  @media (max-width: 480px) {
    .admin-nav {
      width: 100%;
    }
    .admin-nav a {
      padding: 0 10px;
      font-size: 14px;
    }
  }
</style>
