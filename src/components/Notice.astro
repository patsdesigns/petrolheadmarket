---
interface Props {
  tone?: "error" | "ok" | "info";
}
const { tone = "info" } = Astro.props;
---

<div class={`notice notice--${tone}`} role={tone === "error" ? "alert" : "status"}>
  <slot />
</div>

<style>
  .notice {
    border-radius: var(--radius-btn);
    padding: 12px 14px;
    margin-bottom: 18px;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .notice--error {
    border-color: var(--red);
    background: #fdf0f1;
    color: var(--ink);
  }
  .notice--ok {
    border-color: var(--ok-line);
    background: var(--ok-bg);
    color: var(--ok);
  }
  .notice :global(p) {
    margin: 0;
  }
  .notice :global(p + p) {
    margin-top: 8px;
  }
</style>
