---
// Year, make and model as dropdowns for the sell wizard. Each has an "Other"
// choice that shows a text box (CSS :has, so it works without JavaScript).
// Makes and models are filtered to the chosen year (a 1993 Porsche offers no
// Cayenne), and models to the chosen make. The server renders the lists for
// the saved values; a small script refills them when the year or make changes.
import { FIRST_LISTED_YEAR, MAKE_NAMES, OTHER, catalogForClient, makesFor, modelsFor, yearOptions } from "../lib/car-catalog";

interface Props {
  year: string;
  make: string;
  model: string;
  errors: Partial<Record<"year" | "make" | "model", string>>;
}
const { year, make, model, errors } = Astro.props;

const years = yearOptions();
const yearPick = !year ? "" : years.includes(year) ? year : OTHER;

// A saved make or model that the year filter would hide stays in its list,
// so opening the wizard never silently drops what the seller chose.
const makes = makesFor(year);
if (make && MAKE_NAMES.includes(make) && !makes.includes(make)) makes.push(make);
const makePick = !make ? "" : makes.includes(make) ? make : OTHER;

const models = makePick === OTHER ? [] : modelsFor(make, year);
if (model && makePick !== OTHER && modelsFor(make).includes(model) && !models.includes(model)) models.push(model);
const modelPick = !model ? "" : models.includes(model) ? model : OTHER;

const fields = [
  {
    name: "year",
    label: "Year",
    pick: yearPick,
    options: years,
    other: yearPick === OTHER ? year : "",
    otherLabel: `Year (before ${FIRST_LISTED_YEAR})`,
    otherOption: `Before ${FIRST_LISTED_YEAR}`,
    inputmode: "numeric",
    maxlength: 4,
  },
  { name: "make", label: "Make", pick: makePick, options: makes, other: makePick === OTHER ? make : "", otherLabel: "Type the make", otherOption: "Other make", maxlength: 40 },
  { name: "model", label: "Model", pick: modelPick, options: models, other: modelPick === OTHER ? model : "", otherLabel: "Type the model", otherOption: "Other model", maxlength: 60 },
] as const;
---

<div class="field-row field-row--3 car-picker" data-car-picker>
  {
    fields.map((f) => {
      const id = `f-${f.name}`;
      const error = errors[f.name];
      return (
        <div class="car-pick">
          <div class="field">
            <label for={id}>{f.label}</label>
            <select id={id} name={f.name} aria-invalid={error ? "true" : undefined} aria-describedby={error ? `${id}-error` : undefined}>
              <option value="">Choose one</option>
              {f.options.map((o) => <option value={o} selected={o === f.pick}>{o}</option>)}
              <option value={OTHER} selected={f.pick === OTHER}>{f.otherOption}</option>
            </select>
            {error && <span class="error" id={`${id}-error`}>{error}</span>}
          </div>
          <div class="field car-other">
            <label for={`${id}_other`}>{f.otherLabel}</label>
            <input
              id={`${id}_other`}
              name={`${f.name}_other`}
              value={f.other}
              maxlength={f.maxlength}
              inputmode={"inputmode" in f ? f.inputmode : undefined}
              autocomplete="off"
            />
          </div>
        </div>
      );
    })
  }
</div>
<script type="application/json" id="car-catalog" set:html={JSON.stringify(catalogForClient()).replace(/</g, "\\u003c")} />

<style>
  .car-pick {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .car-other {
    display: none;
  }
  .car-pick:has(option[value="__other"]:checked) .car-other {
    display: grid;
  }
</style>

<script>
  type Range = [number, number | null];
  const OTHER = "__other";
  const FIRST = 1920;
  const root = document.querySelector<HTMLElement>("[data-car-picker]");
  const catalog = JSON.parse(document.getElementById("car-catalog")?.textContent || "{}") as Record<string, [string, Range[]][]>;
  const pickSelect = (id: string) => document.getElementById(id) as HTMLSelectElement | null;
  const year = pickSelect("f-year");
  const make = pickSelect("f-make");
  const model = pickSelect("f-model");

  /** The chosen year when it is one of the listed years, else no filter. */
  function chosenYear(): number | null {
    const y = Number(year?.value);
    return Number.isInteger(y) && y >= FIRST ? y : null;
  }
  const builtIn = (ranges: Range[], y: number | null) => !y || ranges.some(([a, b]) => y >= a && y <= (b ?? 9999));

  /** Refill a select between Choose one and Other, keeping the pick when it is still offered. */
  function refill(sel: HTMLSelectElement, names: string[]) {
    const keep = sel.value;
    const first = sel.options[0];
    const other = sel.options[sel.options.length - 1];
    sel.replaceChildren(first, ...names.map((n) => new Option(n, n)), other);
    sel.value = keep === OTHER || names.includes(keep) ? keep : "";
  }

  function refillModels() {
    if (!make || !model) return;
    if (make.value === OTHER) {
      // A make with no list goes straight to typing the model.
      refill(model, []);
      model.value = OTHER;
      return;
    }
    const y = chosenYear();
    refill(model, (catalog[make.value] ?? []).filter(([, r]) => builtIn(r, y)).map(([n]) => n));
  }

  year?.addEventListener("change", () => {
    if (!make) return;
    const y = chosenYear();
    refill(make, Object.keys(catalog).filter((m) => catalog[m].some(([, r]) => builtIn(r, y))));
    refillModels();
  });
  make?.addEventListener("change", refillModels);

  // Picking Other moves the cursor into its text box.
  [year, make, model].forEach((sel) =>
    sel?.addEventListener("change", (e: Event) => {
      if (sel.value === OTHER && e.isTrusted) document.getElementById(`${sel.id}_other`)?.focus();
    }),
  );
</script>
