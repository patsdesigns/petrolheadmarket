---
import { formatMiles, formatPrice, listingTitle } from "../lib/listing-rules";
import { carUrl } from "../lib/paths";
import type { Listing } from "../db/schema";

interface Props {
  listing: Listing;
  mainPhoto: string | null;
  sellerName: string;
  /** Large: photo on top, used as the left column on desktop. */
  size?: "compact" | "large";
}
const { listing, mainPhoto, sellerName, size = "compact" } = Astro.props;
const location = [listing.locationCity, listing.locationState].filter(Boolean).join(", ");
---

<a class:list={["car-sum", "card", { "car-sum--large": size === "large" }]} href={listing.slug ? carUrl(listing.slug) : undefined}>
  {mainPhoto ? <img src={mainPhoto} alt="" /> : <span class="car-sum__ph"></span>}
  <span class="car-sum__body">
    <strong>{listingTitle(listing)}</strong>
    <span class="price">Asking {formatPrice(listing.price)}</span>
    <span class="car-sum__meta">{[listing.mileage !== null ? `${formatMiles(listing.mileage)} mi` : "", location, `Seller: ${sellerName}`].filter(Boolean).join(" · ")}</span>
  </span>
</a>

<style>
  .car-sum {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 14px;
    align-items: center;
    padding: 10px;
    text-decoration: none;
    color: inherit;
    margin-bottom: 20px;
  }
  .car-sum img,
  .car-sum__ph {
    width: 120px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    background: var(--stripes);
  }
  .car-sum__body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .car-sum strong {
    font-size: 18px;
  }
  .car-sum--large {
    grid-template-columns: 1fr;
    padding: 0;
    overflow: hidden;
    margin: 0;
  }
  .car-sum--large img,
  .car-sum--large .car-sum__ph {
    width: 100%;
    border-radius: 0;
  }
  .car-sum--large .car-sum__body {
    padding: 4px 20px 20px;
    gap: 6px;
  }
  .car-sum--large strong {
    font-size: 24px;
  }
  .car-sum--large .price {
    font-size: 18px;
  }
  .car-sum__meta {
    color: var(--muted);
    font-size: 14px;
  }
</style>
