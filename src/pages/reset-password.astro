---
import { z } from "zod";
import AuthLayout from "../layouts/AuthLayout.astro";
import Field from "../components/Field.astro";
import Notice from "../components/Notice.astro";
import { url } from "../lib/paths";
import { parseForm, passwordField } from "../lib/forms";
import { callAuth, friendlyAuthError } from "../lib/auth-call";

const tokenFromLink = Astro.url.searchParams.get("token") ?? "";
const linkError = Astro.url.searchParams.get("error");

let errors: Record<string, string> = {};
let formError = linkError ? "This reset link has expired or was already used. Ask for a new one." : "";
let token = tokenFromLink;

if (Astro.request.method === "POST") {
  const parsed = await parseForm(
    Astro.request,
    z
      .object({
        token: z.string().min(1).max(200),
        password: passwordField,
        confirm: z.string().max(128),
      })
      .refine((d) => d.password === d.confirm, { path: ["confirm"], message: "The passwords do not match." }),
  );
  token = parsed.values.token ?? "";
  if (!parsed.ok) {
    errors = parsed.errors;
    if (errors.token) formError = "This reset link is not complete. Ask for a new one.";
  } else {
    const result = await callAuth(Astro.request, "/reset-password", {
      newPassword: parsed.data.password,
      token: parsed.data.token,
    });
    if (result.ok) return Astro.redirect(`${url("/login")}?notice=password-reset`, 303);
    formError = friendlyAuthError(result);
  }
}
---

<AuthLayout title="Choose a new password">
  {formError && <Notice tone="error"><p>{formError}</p></Notice>}
  {
    token && !linkError ? (
      <form method="post" novalidate>
        <input type="hidden" name="token" value={token} />
        <Field name="password" label="New password" type="password" autocomplete="new-password" error={errors.password} maxlength={128} hint="At least 8 characters." />
        <Field name="confirm" label="Type it again" type="password" autocomplete="new-password" error={errors.confirm} maxlength={128} />
        <button class="btn" type="submit">Save new password</button>
      </form>
    ) : (
      <a class="btn" href={url("/forgot-password")}>Get a new reset link</a>
    )
  }
  <Fragment slot="after">
    <p><a href={url("/login")}>Back to sign in</a></p>
  </Fragment>
</AuthLayout>
