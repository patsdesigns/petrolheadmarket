---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import { url, GARAGE } from "../../lib/paths";
import InboxList from "../../components/InboxList.astro";
import "../../styles/inbox.css";
import { inboxFor } from "../../lib/messaging";

const user = Astro.locals.user!;
const rows = await inboxFor(user.id);
---

<Base title="Inbox">
  <Crumbs items={[{ label: "My Garage", href: url(GARAGE) }, { label: "Inbox" }]} />
  <div class="page-head">
    <h1 class="page-title">Inbox</h1>
  </div>
  <div class="inbox">
    <div class="inbox__list">
      <InboxList rows={rows} />
    </div>
    <div class="inbox__pane">
      <p class="inbox__placeholder">
        {rows.length ? "Pick a conversation to read it." : "Your conversations with buyers and sellers will show here."}
      </p>
    </div>
  </div>
</Base>
