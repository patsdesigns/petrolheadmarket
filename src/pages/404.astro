---
import Base from "../layouts/Base.astro";
import { url, siteUrl, GARAGE } from "../lib/paths";

const signedIn = Boolean(Astro.locals.user);
---

<Base title="Page Not Found">
  <h1 class="page-title">Page Not Found</h1>
  <p class="lede">That page does not exist or has moved.</p>
  <p style="display:flex;gap:12px;flex-wrap:wrap">
    <a class="btn" href={signedIn ? url(GARAGE) : `${url("/login")}?next=${encodeURIComponent(url(GARAGE))}`}>{signedIn ? "Go to My Garage" : "Sign in"}</a>
    <a class="btn btn--secondary" href={siteUrl("/")}>Browse cars</a>
  </p>
</Base>
