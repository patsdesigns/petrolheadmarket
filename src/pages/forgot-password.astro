---
import { z } from "zod";
import AuthLayout from "../layouts/AuthLayout.astro";
import Field from "../components/Field.astro";
import Notice from "../components/Notice.astro";
import { url } from "../lib/paths";
import { emailField, parseForm } from "../lib/forms";
import { callAuth, friendlyAuthError } from "../lib/auth-call";
import { emailConfigured, supportEmail } from "../lib/config";
import { contactHref } from "../lib/contact";

const emailOn = emailConfigured();
const byEmail = Boolean(supportEmail());
const helpHref = contactHref("account", { subject: "Password help" });

let errors: Record<string, string> = {};
let values: Record<string, string> = {};
let formError = "";
let sent = false;

// While email is off, only ADMIN_EMAILS addresses get a reset link, and it
// goes to the Cloudflare Workers log (src/lib/email.ts). That is how the owner
// confirms his address (or takes back one someone else signed up with
// first). The page says the same for any address, and never names the
// setting or the log, so members see plain words. Every address takes the
// same path (rate limit, Better Auth, sendEmail decides what is logged), so
// response timing never tells an attacker which addresses are admins.
if (Astro.request.method === "POST") {
  const parsed = await parseForm(Astro.request, z.object({ email: emailField }));
  values = parsed.values;
  if (!parsed.ok) {
    errors = parsed.errors;
  } else {
    const result = await callAuth(Astro.request, "/request-password-reset", {
      email: parsed.data.email,
      redirectTo: url("/reset-password"),
    });
    // Same message whether or not the account exists.
    if (result.ok) sent = true;
    else formError = friendlyAuthError(result);
  }
}
---

<AuthLayout
  title="Reset your password"
  lede={emailOn ? "Enter the email you signed up with and we will send you a link to choose a new password." : undefined}
>
  {
    !emailOn ? (
      <>
        <Notice tone="info">
          <p>Password reset by email is not switched on yet, so we cannot send you a reset link right now.</p>
          <p>
            If you remember your password, sign in as usual. Otherwise,{" "}
            <a href={helpHref}>{byEmail ? "email our team" : "contact the team"}</a> and we will help you get back in.
          </p>
        </Notice>
        <details class="owner" open={sent || Boolean(formError) || Object.keys(errors).length > 0}>
          <summary>Site owner</summary>
          {sent ? (
            <p>If that is an owner account, its reset link was written to the site log. It works for one hour.</p>
          ) : (
            <>
              <p class="muted">Owner accounts can get a reset link written to the site log.</p>
              {formError && <Notice tone="error"><p>{formError}</p></Notice>}
              <form method="post" novalidate>
                <Field name="email" label="Owner email" type="email" inputmode="email" autocomplete="email" value={values.email} error={errors.email} maxlength={254} />
                <button class="btn btn--secondary" type="submit">Write a reset link to the log</button>
              </form>
            </>
          )}
        </details>
      </>
    ) : sent ? (
      <Notice tone="ok">
        <p>If there is an account for {values.email}, a reset link is on its way. It works for one hour.</p>
        <p>Nothing after a few minutes? Check your spam folder.</p>
      </Notice>
    ) : (
      <>
        {formError && <Notice tone="error"><p>{formError}</p></Notice>}
        <form method="post" novalidate>
          <Field name="email" label="Email" type="email" inputmode="email" autocomplete="email" value={values.email} error={errors.email} maxlength={254} />
          <button class="btn" type="submit">Send reset link</button>
        </form>
      </>
    )
  }
  <Fragment slot="after">
    <p><a href={url("/login")}>Back to sign in</a></p>
  </Fragment>
</AuthLayout>

<style>
  .owner {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--hair);
  }
  .owner summary {
    min-height: var(--tap);
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 700;
    color: var(--muted);
  }
  .owner p {
    margin: 0 0 12px;
  }
  .muted {
    color: var(--muted);
  }
</style>
