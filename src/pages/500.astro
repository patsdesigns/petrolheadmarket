---
import { SITE_NAME } from "../lib/brand";
import "../styles/global.css";
import { url, siteUrl, GARAGE } from "../lib/paths";

// Rendered when something breaks. Kept free of database calls so it can't fail too.
interface Props {
  error?: unknown;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Something went wrong | {SITE_NAME}</title>
  </head>
  <body>
    <header class="bar">
      <div class="container"><a href={siteUrl("/")}>{SITE_NAME}</a></div>
    </header>
    <main>
      <div class="container">
        <h1 class="page-title">Something went wrong</h1>
        <p class="lede">
          Sorry, that did not work, and what you just sent may not have been saved. Go back, check your changes and try
          again in a moment.
        </p>
        <p style="display:flex;gap:12px;flex-wrap:wrap">
          {/* Sign in forwards signed-in people straight to My garage. */}
          <a class="btn" href={`${url("/login")}?next=${encodeURIComponent(url(GARAGE))}`}>Go to my garage</a>
          <a class="btn btn--secondary" href={siteUrl("/")}>Browse cars</a>
        </p>
      </div>
    </main>
    <style>
      .bar {
        min-height: var(--header-h);
        display: flex;
        align-items: center;
        background: var(--glass-strong);
        -webkit-backdrop-filter: var(--glass-blur-strong);
        backdrop-filter: var(--glass-blur-strong);
        border-bottom: 1px solid rgba(21, 23, 27, 0.06);
      }
      .bar a {
        color: var(--ink);
        font-weight: 900;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-decoration: none;
      }
    </style>
  </body>
</html>
