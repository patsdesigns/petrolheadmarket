---
import "../styles/global.css";
import { url, siteUrl } from "../lib/paths";

// Rendered when something breaks. Kept free of database calls so it can't fail too.
interface Props {
  error?: unknown;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Something went wrong | Petrol Head Market</title>
  </head>
  <body>
    <header class="bar">
      <div class="container"><a href={siteUrl("/")}>Petrol Head Market</a></div>
    </header>
    <main>
      <div class="container">
        <h1 class="page-title">Something went wrong</h1>
        <p class="lede">Sorry, that did not work. Your work is saved. Try again in a moment.</p>
        <p style="display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn" href={url("/")}>Go to my garage</a>
          <a class="btn btn--secondary" href={siteUrl("/")}>Browse cars</a>
        </p>
      </div>
    </main>
    <style>
      .bar {
        background: var(--ink);
        padding: 20px 0;
      }
      .bar a {
        color: #fff;
        font-weight: 900;
        text-decoration: none;
      }
    </style>
  </body>
</html>
