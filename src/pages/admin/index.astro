---
import { asc, desc, eq, inArray, count } from "drizzle-orm";
import Base from "../../layouts/Base.astro";
import AdminNav from "../../components/AdminNav.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { getDb } from "../../db/client";
import { listings, listingPhotos, profiles } from "../../db/schema";
import { url } from "../../lib/paths";
import { formatPrice, listingTitle } from "../../lib/listing-rules";
import Notice from "../../components/Notice.astro";
import { emailConfigured } from "../../lib/config";

// Middleware already limits /admin to admins; check again here.
if (Astro.locals.profile?.role !== "admin") return Astro.rewrite(url("/404"));

if (Astro.request.method === "POST") return Astro.redirect(url("/admin"), 303);

const db = getDb();
const rows = await db
  .select({
    id: listings.id,
    status: listings.status,
    year: listings.year,
    make: listings.make,
    model: listings.model,
    price: listings.price,
    submittedAt: listings.submittedAt,
    updatedAt: listings.updatedAt,
    seller: profiles.displayName,
  })
  .from(listings)
  .leftJoin(profiles, eq(profiles.userId, listings.userId))
  .where(inArray(listings.status, ["submitted", "approved"]))
  .orderBy(asc(listings.submittedAt))
  .all();

const photoCounts = new Map(
  (
    await db
      .select({ id: listingPhotos.listingId, n: count() })
      .from(listingPhotos)
      .groupBy(listingPhotos.listingId)
      .all()
  ).map((r) => [r.id, r.n]),
);

const queue = rows.filter((r) => r.status === "submitted");
const stuck = rows.filter((r) => r.status === "approved");

const recent = await db
  .select({ id: listings.id, status: listings.status, year: listings.year, make: listings.make, model: listings.model, reviewedAt: listings.reviewedAt })
  .from(listings)
  .where(inArray(listings.status, ["live", "changes_requested", "rejected", "offer_accepted", "sold", "withdrawn"]))
  .orderBy(desc(listings.reviewedAt))
  .limit(10)
  .all();

const done = Astro.url.searchParams.get("done");
const doneText: Record<string, string> = { changes: "Changes requested.", reject: "Listing rejected." };
const emailNote = emailConfigured()
  ? "The seller was emailed your note."
  : "Email is not set up, so the seller was not emailed. They see your note in My garage.";

const waited = (d: Date | null) => {
  if (!d) return "";
  const hours = Math.floor((Date.now() - d.getTime()) / 3_600_000);
  return hours < 1 ? "under an hour" : hours < 48 ? `${hours}h` : `${Math.floor(hours / 24)}d`;
};
---

<Base title="Review queue">
  <AdminNav current="queue" />
  <h1 class="page-title">Review queue</h1>
  <p class="lede">{queue.length === 0 ? "Nothing waiting. Nice." : `${queue.length} waiting, oldest first.`}</p>
  {done && doneText[done] && <Notice tone="ok"><p>{doneText[done]} {emailNote}</p></Notice>}

  {
    stuck.length > 0 && (
      <section class="card warn">
        <h2>Approved, not live yet</h2>
        <p class="muted">These were approved but did not go live. Open one to see the error and publish it now.</p>
        <ul class="rows">
          {stuck.map((r) => (
            <li class="spec-row">
              <a href={url(`/admin/listings/${r.id}`)}>{listingTitle(r)}</a>
              <StatusBadge status={r.status} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    queue.length > 0 && (
      <table class="table queue">
        <thead>
          <tr>
            <th scope="col">Car</th>
            <th scope="col">Seller</th>
            <th scope="col" class="num">Price</th>
            <th scope="col" class="num">Photos</th>
            <th scope="col" class="num">Waiting</th>
            <th scope="col"><span class="sr-only">Action</span></th>
          </tr>
        </thead>
        <tbody>
          {queue.map((r) => (
            <tr>
              <td><a class="car" href={url(`/admin/listings/${r.id}`)}>{listingTitle(r)}</a></td>
              <td data-label="Seller">{r.seller}</td>
              <td data-label="Price" class="num">{formatPrice(r.price)}</td>
              <td data-label="Photos" class="num">{photoCounts.get(r.id) ?? 0}</td>
              <td data-label="Waiting" class="num">{waited(r.submittedAt)}</td>
              <td class="num"><a class="btn btn--secondary" href={url(`/admin/listings/${r.id}`)}>Review</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  {
    recent.length > 0 && (
      <section class="recent">
        <h2 class="label">Recently reviewed</h2>
        <ul class="rows">
          {recent.map((r) => (
            <li class="spec-row">
              <a href={url(`/admin/listings/${r.id}`)}>{listingTitle(r)}</a>
              <StatusBadge status={r.status} />
            </li>
          ))}
        </ul>
        <p><a href={url("/admin/listings")}>See all listings</a></p>
      </section>
    )
  }
</Base>

<style>
  .warn {
    box-shadow: inset 4px 0 0 var(--red), var(--glass-shadow);
    margin-bottom: 20px;
  }
  .queue {
    margin-bottom: 40px;
  }
  .queue .car {
    font-weight: 700;
    color: var(--ink);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .item {
    padding: 0;
  }
  .item a {
    border-radius: inherit;
    display: grid;
    gap: 6px;
    padding: 16px 18px;
    color: inherit;
    text-decoration: none;
  }
  .item a:hover strong {
    text-decoration: underline;
  }
  .item strong {
    font-size: 18px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    color: var(--muted);
    font-family: var(--font-label);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .meta .price {
    color: var(--ink);
  }
  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rows .spec-row > :first-child {
    font-family: inherit;
    text-transform: none;
    letter-spacing: 0;
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
    flex: 1;
  }
  .muted {
    color: var(--muted);
  }
</style>
