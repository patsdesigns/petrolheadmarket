---
import { and, desc, eq, isNull } from "drizzle-orm";
import Base from "../../layouts/Base.astro";
import Notice from "../../components/Notice.astro";
import { getDb } from "../../db/client";
import { listings, messages, profiles, threads } from "../../db/schema";
import { url } from "../../lib/paths";
import { listingTitle } from "../../lib/listing-rules";
import { audit } from "../../lib/audit";

const admin = Astro.locals.user!;
if (Astro.locals.profile?.role !== "admin") return Astro.rewrite(url("/404"));
const db = getDb();

if (Astro.request.method === "POST") {
  const id = String((await Astro.request.formData()).get("messageId") ?? "").slice(0, 64);
  const done = await db
    .update(messages)
    .set({ flagReviewedAt: new Date() })
    .where(and(eq(messages.id, id), eq(messages.flagged, true)))
    .returning({ id: messages.id })
    .get();
  if (done) await audit(admin.id, "flag_reviewed", "message", id);
  return Astro.redirect(`${url("/admin/flags")}?done=1`, 303);
}

const rows = await db
  .select({ message: messages, thread: threads, listing: listings, sender: profiles.displayName })
  .from(messages)
  .innerJoin(threads, eq(threads.id, messages.threadId))
  .innerJoin(listings, eq(listings.id, threads.listingId))
  .leftJoin(profiles, eq(profiles.userId, messages.senderId))
  .where(and(eq(messages.flagged, true), isNull(messages.flagReviewedAt)))
  .orderBy(desc(messages.createdAt))
  .limit(100)
  .all();
---

<Base title="Flagged messages">
  <nav class="admin-nav" aria-label="Admin">
    <a href={url("/admin")}>Review queue</a>
    <a href={url("/admin/flags")} aria-current="page">Flagged messages</a>
  </nav>
  <h1 class="page-title">Flagged messages</h1>
  <p class="lede">Messages that look like common scams. They were delivered. Check the conversation and act if needed.</p>
  {Astro.url.searchParams.get("done") && <Notice tone="ok"><p>Marked as reviewed.</p></Notice>}
  {
    rows.length === 0 ? (
      <p class="muted">Nothing flagged right now.</p>
    ) : (
      <ul class="flags">
        {rows.map((r) => (
          <li class="card">
            <p class="label">{r.message.flagReason}</p>
            <p class="body">{r.message.body}</p>
            <p class="meta">
              From <strong>{r.sender ?? "Member"}</strong> ({r.message.senderId === r.thread.buyerId ? "buyer" : "seller"}) about the{" "}
              {listingTitle(r.listing)}
            </p>
            <div class="actions">
              <a class="btn btn--secondary" href={url(`/inbox/${r.thread.id}`)}>Open conversation</a>
              <form method="post">
                <input type="hidden" name="messageId" value={r.message.id} />
                <button class="btn btn--secondary" type="submit">Mark reviewed</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .admin-nav {
    display: flex;
    gap: 18px;
    margin-bottom: 16px;
    font-weight: 700;
  }
  .admin-nav a {
    color: var(--muted);
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .admin-nav a[aria-current] {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--red);
  }
  .flags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
    max-width: 760px;
  }
  .label {
    color: var(--red);
  }
  .body {
    white-space: pre-wrap;
    margin: 6px 0;
  }
  .meta {
    color: var(--muted);
    font-size: 14px;
  }
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .actions form {
    margin: 0;
  }
  .muted {
    color: var(--muted);
  }
</style>
