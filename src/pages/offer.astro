---
import { z } from "zod";
import Base from "../layouts/Base.astro";
import Field from "../components/Field.astro";
import Notice from "../components/Notice.astro";
import CarSummary from "../components/CarSummary.astro";
import { url } from "../lib/paths";
import { parseForm } from "../lib/forms";
import { getPublicListing, isAppSlug, slugFromReferer, validSlug } from "../lib/public-listing";
import NotOnApp from "../components/NotOnApp.astro";
import { createOffer, expireStaleOffers, minOffer, openOfferFor, OFFER_HOURS } from "../lib/offers";
import { offerRateLimited } from "../lib/rate-limit";
import { formatPrice } from "../lib/listing-rules";
import { canTransact, publicOrigin } from "../lib/config";
import type { Listing } from "../db/schema";

// Look the listing up before anything else: the Lot's sample listings are
// not in the app, and nobody should have to sign up to find that out.
const rawSlug = Astro.url.searchParams.get("listing");
if (!rawSlug) {
  const fromReferer = slugFromReferer(Astro.request, publicOrigin());
  if (fromReferer) return Astro.redirect(`${url("/offer")}?listing=${encodeURIComponent(fromReferer)}`, 303);
}
const slug = validSlug(rawSlug);
const found = slug ? await getPublicListing(slug) : null;
let notOpen: "sample" | "gone" | "missing" | null = null;
if (!found) {
  // A friendly page with status 200: the Lot links here from every car, and a
  // 404 status could be replaced by the host's generic error page.
  notOpen = !rawSlug ? "missing" : slug && (await isAppSlug(slug)) ? "gone" : "sample";
}
// A real listing needs an account (the middleware lets signed-out GETs through to here).
const maybeUser = Astro.locals.user;
if (found && !maybeUser) {
  return Astro.redirect(`${url("/login")}?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`, 303);
}
// Below here only runs for a real listing and a signed-in person; the
// template shows NotOnApp otherwise.
const user = maybeUser!;
const listing = found?.listing as Listing;
const selfUrl = `${url("/offer")}?listing=${encodeURIComponent(slug ?? "")}`;

let errors: Record<string, string> = {};
let values: Record<string, string> = {};
let formError = "";

const isOwn = found ? listing.userId === user.id : false;
if (found) await expireStaleOffers();
const open = found ? await openOfferFor(listing.id, user.id) : undefined;
const closed = !found || listing.status !== "live" || !listing.acceptsOffers;

if (found && Astro.request.method === "POST" && !isOwn && !closed) {
  const parsed = await parseForm(
    Astro.request,
    z.object({
      amount: z
        .string()
        .trim()
        .transform((v) => Number(v.replace(/[$,\s]/g, "")))
        .pipe(z.number({ message: "Enter an amount in dollars." }).int("Use whole dollars.").min(1, "Enter an amount in dollars.").max(100_000_000)),
      message: z.string().trim().max(1000, "Keep your note under 1,000 characters.").optional(),
    }),
  );
  values = parsed.values;
  if (!parsed.ok) errors = parsed.errors;
  else if (!canTransact(user)) formError = "Confirm your email before you make an offer.";
  else if (await offerRateLimited(user.id)) formError = "You have made a lot of offers in the last hour. Try again later.";
  else {
    const result = await createOffer(listing, user.id, parsed.data.amount, parsed.data.message || null);
    if (result.ok) return Astro.redirect(`${url("/offers")}?sent=1`, 303);
    formError = result.error;
  }
}
---

<Base title="Make an offer">
  {notOpen || !found ? (
    <NotOnApp reason={notOpen ?? "missing"} slug={slug} action="offer" />
  ) : (
  <>
  <a class="back" href={url("/offers")}>← Offers</a>
  <h1 class="page-title">Make an offer</h1>
  <div class="split">
  <CarSummary {...found} size="large" />
  <div class="split__main">

  {
    isOwn ? (
      <Notice tone="info"><p>This is your car. Offers from buyers show up in <a href={url("/offers")}>Offers</a>.</p></Notice>
    ) : closed ? (
      <Notice tone="info">
        <p>
          {listing.status === "live"
            ? "The seller is not taking offers on this car. You can still message them."
            : "This car is no longer taking offers."}
        </p>
        {listing.status === "live" && <p><a href={`${url("/message")}?listing=${encodeURIComponent(slug ?? "")}`}>Message the seller</a></p>}
      </Notice>
    ) : open ? (
      <Notice tone="info">
        <p>
          You have an open {open.madeBy === "seller" ? "counter offer from the seller" : "offer"} of {formatPrice(open.amount)} on this car.
          {" "}<a href={url("/offers")}>See it in Offers</a>.
        </p>
      </Notice>
    ) : (
      <div class="card offer">
        <div class="buy__label">Asking price</div>
        <div class="buy__price">{formatPrice(listing.price)}</div>
        <p class="floor">Offers from {formatPrice(minOffer(listing.price!))} (half the asking price)</p>
        {!canTransact(user) && (
          <Notice tone="info">
            <p><a href={`${url("/verify-email")}?next=${encodeURIComponent(selfUrl)}`}>Confirm your email</a> to make an offer.</p>
          </Notice>
        )}
        {formError && <Notice tone="error"><p>{formError}</p></Notice>}
        <form method="post" novalidate>
          <Field name="amount" label="Your offer" inputmode="numeric" value={values.amount} error={errors.amount} maxlength={12}
            hint={`Whole dollars. At least ${formatPrice(minOffer(listing.price!))}, half the asking price.`} />
          <div class="field">
            <label for="f-message">Note to the seller</label>
            <span class="hint" id="f-message-hint">Optional. Say when you could see the car. Keep phone numbers and payment details for after the seller accepts.</span>
            <textarea id="f-message" name="message" rows="4" maxlength="1000" aria-describedby="f-message-hint">{values.message ?? ""}</textarea>
            {errors.message && <span class="error">{errors.message}</span>}
          </div>
          <p class="muted">
            The seller has {OFFER_HOURS} hours to accept, counter or decline. If they accept, you both get each other's contact
            details to arrange an inspection and payment.
          </p>
          <button class="btn" type="submit" disabled={!canTransact(user)}>Send offer</button>
        </form>
      </div>
    )
  }
  </div>
  </div>
  </>
  )}
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 32px;
    align-items: start;
    margin-top: 8px;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  .offer {

  }
  .floor {
    margin: 6px 0 18px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hair);
    color: var(--muted);
    font-family: var(--font-label);
    font-size: 12px;
  }
  .muted {
    color: var(--muted);
    font-size: 14px;
  }
</style>
