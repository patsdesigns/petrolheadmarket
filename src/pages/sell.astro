---
import { SITE_NAME } from "../lib/brand";
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Notice from "../components/Notice.astro";
import { url, GARAGE } from "../lib/paths";
import { canTransact } from "../lib/config";
import { createDraft, listForUser, MAX_OPEN_DRAFTS } from "../lib/listings";
import { listingTitle } from "../lib/listing-rules";
import { MIN_PHOTOS, MIN_DESCRIPTION } from "../lib/listing-options";
import { feeLine, launchStatus } from "../lib/fees";

const user = Astro.locals.user!;
let error = "";

if (Astro.request.method === "POST") {
  const id = await createDraft(user.id);
  if (id) return Astro.redirect(`${url(`/listings/${id}/edit`)}?step=car`, 303);
  error = `You have ${MAX_OPEN_DRAFTS} drafts open. Finish or delete one below before starting another.`;
}
const notice = Astro.url.searchParams.get("notice");

const fee = feeLine(await launchStatus(user.id));
const drafts = (await listForUser(user.id)).filter((l) => l.status === "draft" || l.status === "changes_requested");
---

<Base title="Sell Your Car">
  <Crumbs items={[{ label: "My Garage", href: url(GARAGE) }, { label: "Sell Your Car" }]} />
  <h1 class="page-title">Sell Your Car</h1>
  <p class="lede">
    A real person reviews every car before it goes live, so buyers know they are looking at an honest listing. It takes
    about 20 minutes, and your progress saves as you go.
  </p>
  <p class="fee-note">{fee}</p>

  {error && <Notice tone="error"><p>{error}</p></Notice>}
  {notice === "deleted" && <Notice tone="ok"><p>Draft deleted.</p></Notice>}
  {notice === "deleted-listing" && <Notice tone="ok"><p>Listing deleted, with its photos.</p></Notice>}
  {notice === "deleted-kept" && (
    <Notice tone="ok"><p>Listing and photos deleted. Your conversations with buyers stay in your inbox.</p></Notice>
  )}

  {
    drafts.length > 0 && (
      <section class="card drafts" aria-labelledby="drafts-h">
        <h2 id="drafts-h">Pick Up Where You Left Off</h2>
        <ul>
          {drafts.map((d) => (
            <li class="spec-row">
              <span>{listingTitle(d)}</span>
              <span class="draft-actions">
                <a href={`${url(`/listings/${d.id}/edit`)}`}>Continue</a>
                {d.status === "draft" && (
                  <form method="post" action={url(`/listings/${d.id}`)}
                    onsubmit="return confirm('Delete this draft and its photos? This cannot be undone.')">
                    <input type="hidden" name="intent" value="delete" />
                    <input type="hidden" name="back" value="sell" />
                    <button class="linkish" type="submit" aria-label={`Delete ${listingTitle(d)}`}>Delete</button>
                  </form>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="sell-grid">
    <section class="card" aria-labelledby="need-h">
      <h2 id="need-h">What You Will Need</h2>
      <ul class="needs">
        <li><strong>At least {MIN_PHOTOS} photos.</strong> Outside, inside, engine bay, underside and any flaws.</li>
        <li><strong>The VIN</strong> for cars from 1981 on.</li>
        <li><strong>The mileage and title status.</strong></li>
        <li><strong>The story.</strong> At least {MIN_DESCRIPTION} characters on how you have owned and cared for it.</li>
        <li><strong>Honest known issues.</strong> Every used car has some.</li>
      </ul>
    </section>
    <section class="card" aria-labelledby="how-h">
      <h2 id="how-h">How It Works</h2>
      <ol class="how">
        <li>Describe the car and add photos.</li>
        <li>Set your price and choose how buyers reach you.</li>
        <li>Submit for review. We check it, usually within a day.</li>
        <li>It goes live on {SITE_NAME}. Buyers message you or make offers.</li>
      </ol>
      {
        !canTransact(user) && (
          <p class="muted">
            You can start now. You will need to <a href={url("/verify-email")}>confirm your email</a> before you submit.
          </p>
        )
      }
      <form method="post">
        <button class="btn" type="submit">Start a new listing</button>
      </form>
    </section>
  </div>
</Base>

<style>
  .fee-note {
    display: inline-block;
    margin: -8px 0 24px;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--ok-bg);
    color: var(--ok);
    font-weight: 600;
    max-width: 760px;
  }
  .drafts {
    margin-bottom: 20px;
    max-width: 760px;
  }
  .drafts ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .drafts .spec-row > :first-child {
    font-family: inherit;
    text-transform: none;
    letter-spacing: 0;
    font-size: 16px;
    color: var(--ink);
    font-weight: 600;
    flex: 1 1 auto;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .drafts a {
    font-weight: 700;
  }
  .drafts .spec-row {
    gap: 12px;
    align-items: center;
  }
  .draft-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }
  .draft-actions form {
    margin: 0;
  }
  .linkish {
    border: 0;
    background: none;
    color: var(--red);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }
  .draft-actions a,
  .draft-actions .linkish {
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .sell-grid {
    display: grid;
    gap: 20px;
    max-width: 760px;
  }
  @media (min-width: 800px) {
    .sell-grid {
      grid-template-columns: 1fr 1fr;
      max-width: none;
    }
  }
  .needs,
  .how {
    padding-left: 20px;
    margin: 0 0 18px;
  }
  .needs li,
  .how li {
    margin: 8px 0;
  }
  .muted {
    color: var(--muted);
  }
</style>
