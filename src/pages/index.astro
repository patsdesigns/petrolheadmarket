---
import Base from "../layouts/Base.astro";
import Notice from "../components/Notice.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { url } from "../lib/paths";
import { listForUser } from "../lib/listings";
import { formatMiles, formatPrice, listingTitle } from "../lib/listing-rules";
import { isEditable } from "../lib/listings";

const user = Astro.locals.user!;
const mine = await listForUser(user.id);
const notice = Astro.url.searchParams.get("notice");
---

<Base title="My garage">
  <div class="head">
    <h1 class="page-title">My garage</h1>
    {mine.length > 0 && <a class="btn" href={url("/sell")}>List another car</a>}
  </div>

  {notice === "deleted" && <Notice tone="ok"><p>Draft deleted.</p></Notice>}
  {
    !user.emailVerified && (
      <Notice tone="info">
        <p>
          <a href={url("/verify-email")}>Confirm your email</a> to submit listings, make offers and message sellers.
        </p>
      </Notice>
    )
  }

  {
    mine.length === 0 ? (
      <div class="card empty">
        <h2>Ready to sell your car?</h2>
        <p>
          List it for free. A real person reviews every listing before it goes live, so buyers know they are looking at
          an honest car.
        </p>
        <a class="btn" href={url("/sell")}>Start a listing</a>
      </div>
    ) : (
      <section aria-labelledby="listings-h">
        <h2 id="listings-h" class="label">Your listings</h2>
        <ul class="cars">
          {mine.map((l) => (
            <li class="card car">
              <a class="car__link" href={isEditable(l) && l.status === "draft" ? url(`/listings/${l.id}/edit`) : url(`/listings/${l.id}`)}>
                <div class="car__photo">
                  {l.mainPhoto ? <img src={l.mainPhoto} alt="" loading="lazy" /> : <span>No photos yet</span>}
                </div>
                <div class="car__body">
                  <StatusBadge status={l.status} />
                  <h3>{listingTitle(l)}</h3>
                  <p class="car__meta">
                    <span class="price">{formatPrice(l.price) || "No price"}</span>
                    {l.mileage !== null && <span>{formatMiles(l.mileage)} mi</span>}
                    <span>{l.photoCount} photos</span>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .head h1 {
    margin: 0;
  }
  .empty {
    display: grid;
    gap: 12px;
    justify-items: start;
    max-width: 560px;
  }
  .empty h2 {
    font-size: 24px;
    margin: 0;
  }
  .empty p {
    margin: 0;
    color: var(--muted);
  }
  .cars {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .car {
    padding: 0;
    overflow: hidden;
  }
  .car__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .car__photo {
    aspect-ratio: 4 / 3;
    background: var(--paper);
    display: grid;
    place-items: center;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  .car__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .car__body {
    padding: 14px 16px 16px;
  }
  .car__body h3 {
    font-size: 19px;
    margin: 8px 0 6px;
  }
  .car__meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .car__meta .price {
    color: var(--ink);
  }
  .car__link:hover h3 {
    text-decoration: underline;
  }
</style>
