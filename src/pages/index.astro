---
// The Lot: every car for sale. The search box lives in the site header (on
// this page it belongs to this form, form="lot"); here a row of filter chips
// (year, make, model, trim, exterior color, and More filters for price,
// miles and the rest), the
// newest arrival as a showcase, then the grid. A plain GET form, so it works
// without JavaScript and every search can be shared or bookmarked; a small
// script applies the chips as soon as they change.
import Base from "../layouts/Base.astro";
import { BODY_STYLES, DRIVETRAINS } from "../lib/listing-options";
import { formatMiles, formatPrice } from "../lib/listing-rules";
import { COLORS, SORTS, activeFilterCount, lotHref, norm, parseLotQuery, queryLot, type LotCard, type LotQuery } from "../lib/lot";
import { carUrl, url } from "../lib/paths";
import CarCard from "../components/CarCard.astro";
import SaveButton from "../components/SaveButton.astro";
import { savedAmong } from "../lib/saved";
import "../styles/lot.css";

const q = parseLotQuery(Astro.url.searchParams);
const lot = await queryLot(q);
const signedIn = Boolean(Astro.locals.user);
const saved = await savedAmong(Astro.locals.user?.id, lot.cards.map((c) => c.id));

type Choice = { value: string; label: string };
const moreGroups: { key: keyof LotQuery; legend: string; options: readonly Choice[]; counts: Record<string, number> }[] = [
  { key: "manual", legend: "Transmission", options: [{ value: "1", label: "Manual only" }], counts: lot.counts.manual },
  { key: "drive", legend: "Drivetrain", options: DRIVETRAINS, counts: lot.counts.drive },
  { key: "body", legend: "Body", options: BODY_STYLES, counts: lot.counts.body },
  { key: "color", legend: "Exterior color", options: COLORS, counts: lot.counts.color },
  {
    key: "seller",
    legend: "Seller",
    options: [
      { value: "private", label: "Private party" },
      { value: "dealer", label: "Specialty dealer" },
    ],
    counts: lot.counts.seller,
  },
  { key: "records", legend: "Paperwork", options: [{ value: "1", label: "Records on file" }], counts: lot.counts.records },
];
const isOn = (key: keyof LotQuery, value: string) => {
  const v = q[key];
  return Array.isArray(v) ? v.includes(value) : v === true && value === "1";
};
const hasPrice = q.pmin !== null || q.pmax !== null;
const hasMiles = q.mmin !== null || q.mmax !== null;
const moreOn = moreGroups.reduce((n, g) => n + g.options.filter((o) => isOn(g.key, o.value)).length, 0) + (hasPrice ? 1 : 0) + (hasMiles ? 1 : 0);
const typed = (n: number | null) => (n === null ? "" : n.toLocaleString("en-US"));
const clearMore: Partial<LotQuery> = { manual: false, records: false, color: [], drive: [], body: [], seller: [], pmin: null, pmax: null, mmin: null, mmax: null };

const anyFilter = activeFilterCount(q) > 0;
const noFilters: Partial<LotQuery> = { ymin: null, ymax: null, make: "", model: "", trim: "", ...clearMore };
// The plain Lot: no search, filter or sort (Show more keeps it plain).
const plain = !q.q && !anyFilter && q.sort === "new";

// The newest car leads the plain Lot when there are enough cars.
const feature: LotCard | null = plain && lot.cards.length >= 4 ? lot.cards[0] : null;
const grid = feature ? lot.cards.slice(1) : lot.cards;

const carsText = (n: number) => (n === 1 ? "1 car" : `${n.toLocaleString("en-US")} cars`);
const miles = (n: number | null) => (n === null ? "" : `${formatMiles(n)} mi`);
const facts = (c: LotCard) => [miles(c.mileage), c.transmission, c.location].filter(Boolean);
// "Just listed" (on the cards) is three days from now, computed per request.
const now = Date.now();
const pageTitle = q.q ? `Search: ${q.q}` : "Enthusiast Cars for Sale";
---

<Base
  title={pageTitle}
  index={plain && lot.page === 1}
  description="Enthusiast cars for sale by their owners. Every listing is reviewed by a person. Fixed prices and offers, no auctions."
  image={feature?.photo ? new URL(feature.photo.url, Astro.url).toString() : undefined}
>
  <h1 class="sr-only">Enthusiast Cars for Sale</h1>

  <div class="lot-sentinel" data-lot-sentinel aria-hidden="true"></div>
  <div class="lot" data-lot>
    <form class="toolbar" id="lot" method="get" action={url("/")} role="search" aria-label="Filter cars">
      <select class:list={["chip", { "is-set": q.ymin !== null }]} name="ymin" aria-label="Year from">
        <option value="">Year From</option>
        {lot.years.map((y) => <option value={y} selected={y === q.ymin}>From {y}</option>)}
      </select>
      <select class:list={["chip", { "is-set": q.ymax !== null }]} name="ymax" aria-label="Year to">
        <option value="">Year To</option>
        {lot.years.map((y) => <option value={y} selected={y === q.ymax}>To {y}</option>)}
      </select>
      <select class:list={["chip", { "is-set": !!q.make }]} name="make" aria-label="Make">
        <option value="">Make</option>
        {lot.makes.map((m) => <option value={m.name} selected={norm(m.name) === norm(q.make)}>{m.name}</option>)}
      </select>
      <select
        id="qf-model"
        class:list={["chip", { "is-set": !!q.model }]}
        name="model"
        aria-label={q.make ? "Model" : "Model (pick a make first)"}
        title={q.make ? undefined : "Pick a make first"}
        disabled={!q.make}
      >
        <option value="">Model</option>
        {lot.models.map((m) => <option value={m.name} selected={norm(m.name) === norm(q.model)}>{m.name}</option>)}
      </select>
      <select
        id="qf-trim"
        class:list={["chip", { "is-set": !!q.trim }]}
        name="trim"
        aria-label={q.model ? "Trim" : "Trim (pick a model first)"}
        title={q.model ? undefined : "Pick a model first"}
        disabled={!q.model}
      >
        <option value="">Trim</option>
        {lot.trims.map((t) => <option value={t.name} selected={norm(t.name) === norm(q.trim)}>{t.name}</option>)}
      </select>

      <details class="chip-more" data-more>
        <summary class:list={["chip", { "is-set": moreOn > 0 }]}>
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 7h10M18 7h2M4 17h4M12 17h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><circle
              cx="16"
              cy="7"
              r="2"
              fill="none"
              stroke="currentColor"
              stroke-width="2"></circle><circle cx="10" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="2"></circle></svg
          >
          More Filters
          {moreOn > 0 && <span class="count">{moreOn}</span>}
        </summary>
        <div class="more">
          <div class="more__head">
            <h2 class="more__title">More Filters</h2>
          </div>
          <div class="more__ranges">
            <fieldset class="more__range">
              <legend>Price</legend>
              <div class="more__pair">
                <label class="more__num">
                  <span class="sr-only">Lowest price</span>
                  <span class="more__unit" aria-hidden="true">$</span>
                  <input name="price_min" inputmode="numeric" autocomplete="off" maxlength="11" placeholder="From" value={typed(q.pmin)} />
                </label>
                <span class="more__to" aria-hidden="true">to</span>
                <label class="more__num">
                  <span class="sr-only">Highest price</span>
                  <span class="more__unit" aria-hidden="true">$</span>
                  <input name="price_max" inputmode="numeric" autocomplete="off" maxlength="11" placeholder="To" value={typed(q.pmax)} />
                </label>
              </div>
            </fieldset>
            <fieldset class="more__range">
              <legend>Miles</legend>
              <div class="more__pair">
                <label class="more__num">
                  <span class="sr-only">Fewest miles</span>
                  <input name="miles_min" inputmode="numeric" autocomplete="off" maxlength="11" placeholder="From" value={typed(q.mmin)} />
                </label>
                <span class="more__to" aria-hidden="true">to</span>
                <label class="more__num">
                  <span class="sr-only">Most miles</span>
                  <input name="miles_max" inputmode="numeric" autocomplete="off" maxlength="11" placeholder="To" value={typed(q.mmax)} />
                </label>
              </div>
            </fieldset>
          </div>
          <div class="more__groups">
            {
              moreGroups.map((g) => (
                <fieldset class="more__group">
                  <legend>{g.legend}</legend>
                  {g.options.map((o) => {
                    const n = g.counts[o.value] ?? 0;
                    const on = isOn(g.key, o.value);
                    return (
                      <label class:list={["more__opt", { "is-zero": n === 0 && !on }]}>
                        <input type="checkbox" name={g.key} value={o.value} checked={on} />
                        <span>{o.label}</span>
                        <span class="more__n">{n}</span>
                      </label>
                    );
                  })}
                </fieldset>
              ))
            }
          </div>
          <div class="more__foot">
            {moreOn > 0 && <a class="lot__clear" href={lotHref(q, clearMore)}>Clear these</a>}
            <button class="btn" type="submit">Show results</button>
          </div>
        </div>
      </details>
      <button class="btn btn--secondary quick__apply" type="submit">Apply</button>
      {anyFilter && <a class="lot__clear toolbar__clear" href={lotHref(q, noFilters)}>Clear filters</a>}
    </form>

    {
      feature && (
        <div class="feature-wrap">
        <a class="feature" href={carUrl(feature.slug)}>
          <div class="feature__photo">
            {feature.photo && (
              <img
                src={feature.photo.url}
                alt=""
                width={feature.photo.width ?? undefined}
                height={feature.photo.height ?? undefined}
                fetchpriority="high"
                decoding="async"
              />
            )}
          </div>
          <div class="feature__info">
            <p class="feature__eyebrow">Newest arrival</p>
            <h2 class="feature__title">{feature.title}</h2>
            {feature.headline && <p class="feature__headline">{feature.headline}</p>}
            <p class="feature__facts">{facts(feature).join("  ·  ")}</p>
            <div class="feature__foot">
              <span class="feature__price">{formatPrice(feature.price)}</span>
              <span class="btn">View this car</span>
            </div>
          </div>
        </a>
        <div class="feature-wrap__save">
          <SaveButton listingId={feature.id} saved={saved.has(feature.id)} signedIn={signedIn} />
        </div>
        </div>
      )
    }

    <section class="lot__results" aria-labelledby="results-h">
      <div class="lot__bar">
        <h2 class="lot__count" id="results-h">{feature ? "Just In" : carsText(lot.total)}</h2>
        {feature && <span class="lot__of">{carsText(lot.total)} for sale</span>}
        {
          q.q && (
            <a class="pill" href={lotHref(q, { q: "" })} aria-label={`Remove search ${q.q}`}>
              “{q.q}” <svg class="pill__x" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 2l6 6M8 2L2 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            </a>
          )
        }
        <label class="lot__sort">
          <span class="lot__sort-label">Sort</span>
          <select name="sort" form="lot">
            {SORTS.map((s) => <option value={s.value} selected={s.value === q.sort}>{s.label}</option>)}
          </select>
        </label>
      </div>

      {
        lot.cards.length === 0 ? (
          <div class="lot__empty card">
            {lot.lotSize === 0 ? (
              <>
                <h2>No Cars on the Lot Yet</h2>
                <p>Every car here is reviewed by a person before it goes live. Be one of the first to list yours.</p>
                <a class="btn" href={url("/sell")}>
                  Sell your car
                </a>
              </>
            ) : (
              <>
                <h2>No Cars Match {q.q ? `“${q.q}”` : "These Filters"}</h2>
                <p>Try fewer filters or a shorter search.</p>
                <a class="btn" href={url("/")}>
                  Clear search and filters
                </a>
              </>
            )}
          </div>
        ) : (
          <ul class="lot__grid" role="list">
            {grid.map((c, i) => (
              <CarCard card={c} eager={i < 6} saved={saved.has(c.id)} signedIn={signedIn} now={now} />
            ))}
          </ul>
        )
      }

      {
        lot.cards.length > 0 && (
          <div class="lot__more" data-more-cars>
            <p class="lot__shown">
              Showing {lot.cards.length.toLocaleString("en-US")} of {carsText(lot.total)}
            </p>
            {lot.page < lot.pages && (
              <a class="btn btn--secondary lot__more-btn" href={lotHref(q, { page: lot.page + 1 })} rel="next" data-show-more>
                Show more
              </a>
            )}
          </div>
        )
      }
    </section>
  </div>
</Base>

<script>
  // The Lot without full reloads: the chips and sort apply as soon as they
  // change, More filters with its button, and the page swaps in the new
  // results in place (the address updates, Back and Forward work). Without
  // this script it is a plain GET form and the Apply buttons submit.
  // The filter form (#lot) holds only the chips; the sort menu and the
  // header search join it with form="lot". The whole Lot (.lot) is swapped.
  const lotForm = () => document.getElementById("lot") as HTMLFormElement | null;
  const lotRoot = () => document.querySelector("[data-lot]") as HTMLElement | null;
  const moreBox = () => document.querySelector("[data-more]") as HTMLDetailsElement | null;
  const form = lotRoot();
  if (form && lotForm()) {
    let loading: AbortController | null = null;

    const swap = (next: Document) => {
      const fresh = next.querySelector("[data-lot]");
      const now = lotRoot();
      const keep = lotForm();
      const freshForm = next.getElementById("lot");
      if (!fresh || !now || !keep || !freshForm) return false;
      // Keep the filter form element itself (the header search and the sort
      // menu belong to it by form="lot") and swap what is inside it.
      keep.replaceChildren(...(Array.from(freshForm.childNodes) as unknown as Node[]));
      now.replaceChildren(...(Array.from(fresh.childNodes).map((n) => (n === freshForm ? keep : n)) as unknown as Node[]));
      now.classList.add("is-live");
      const cats = document.querySelector(".cats");
      const freshCats = next.querySelector(".cats");
      if (cats && freshCats) cats.replaceWith(freshCats);
      document.title = next.title;
      const search = document.getElementById("site-q") as HTMLInputElement | null;
      const freshSearch = next.getElementById("site-q") as HTMLInputElement | null;
      if (search && freshSearch && document.activeElement !== search) search.value = freshSearch.value;
      return true;
    };

    // Fetch a Lot address and swap it in; push it to the history unless this
    // is Back or Forward.
    const load = async (href: string, push: boolean) => {
      loading?.abort();
      loading = new AbortController();
      const now = lotRoot();
      now?.classList.add("is-loading");
      now?.setAttribute("aria-busy", "true");
      try {
        const res = await fetch(href, { headers: { Accept: "text/html" }, signal: loading.signal });
        if (!res.ok) throw new Error(String(res.status));
        const next = new DOMParser().parseFromString(await res.text(), "text/html");
        const doSwap = () => {
          if (!swap(next)) window.location.href = href;
        };
        const vt = (document as unknown as { startViewTransition?: (cb: () => void) => { updateCallbackDone: Promise<void> } })
          .startViewTransition;
        if (vt && !matchMedia("(prefers-reduced-motion: reduce)").matches) await vt.call(document, doSwap).updateCallbackDone;
        else doSwap();
        if (push) history.pushState({ lot: true }, "", href);
        // Back to the top of the results if the page was scrolled past them.
        const top = lotRoot()?.getBoundingClientRect().top ?? 0;
        if (top < 0) window.scrollTo({ top: Math.max(0, window.scrollY + top - 90) });
      } catch (err) {
        if ((err as Error).name !== "AbortError") window.location.href = href;
      } finally {
        const after = lotRoot();
        after?.classList.remove("is-loading");
        after?.removeAttribute("aria-busy");
      }
    };

    // Only send the fields that are set, so the address stays short.
    document.addEventListener("formdata", (e) => {
      if (e.target !== lotForm()) return;
      // Typed prices and miles go without "$" and commas ("$25,000" is 25000).
      const clean = ([k, v]: [string, FormDataEntryValue]): [string, FormDataEntryValue] =>
        /_(min|max)$/.test(k) && typeof v === "string" ? [k, v.replace(/[$,\s]/g, "")] : [k, v];
      const keep = [...e.formData.entries()].map(clean).filter(([k, v]) => v !== "" && !(k === "sort" && v === "new"));
      for (const k of new Set([...e.formData.keys()])) e.formData.delete(k);
      for (const [k, v] of keep) e.formData.append(k, v);
    });

    document.addEventListener("submit", (e) => {
      const f = lotForm();
      if (e.target !== f || !f) return;
      e.preventDefault();
      const params = new URLSearchParams(new FormData(f) as unknown as Record<string, string>);
      const str = params.toString();
      const more = moreBox();
      if (more) more.open = false;
      (document.getElementById("site-q") as HTMLInputElement | null)?.blur();
      load(str ? `${f.action}?${str}` : f.action, true);
    });

    document.addEventListener("change", (e) => {
      const t = e.target as HTMLInputElement;
      const f = lotForm();
      if (!f || t.form !== f) return;
      // More filters (and the search box) apply with their buttons.
      if (t.name === "q" || moreBox()?.contains(t)) return;
      // A new make starts with all of its models, a new model with all of its trims.
      const clear = (id: string) => {
        const sel = document.getElementById(id) as HTMLSelectElement | null;
        if (sel) sel.value = "";
      };
      if (t.name === "make") clear("qf-model");
      if (t.name === "make" || t.name === "model") clear("qf-trim");
      f.requestSubmit();
    });

    // Links inside the Lot that only change its filters (Clear filters, the
    // search pill, the menu shortcuts) swap in place too.
    document.addEventListener("click", (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as HTMLElement).closest?.("a") as HTMLAnchorElement | null;
      if (!link || link.hasAttribute("data-show-more")) return;
      const to = new URL(link.href, location.href);
      if (to.origin !== location.origin || to.pathname !== location.pathname || link.target) return;
      if (!link.closest("[data-lot], .cats")) return;
      e.preventDefault();
      load(to.href, true);
    });

    window.addEventListener("popstate", () => load(location.href, false));
    history.replaceState({ lot: true }, "");

    // Show more: fetch the next address (which renders every car so far) and
    // add the cards this page does not have yet. Without the script the link
    // simply opens that address.
    document.addEventListener("click", async (e) => {
      const link = (e.target as HTMLElement).closest?.("[data-show-more]") as HTMLAnchorElement | null;
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      link.setAttribute("aria-busy", "true");
      link.textContent = "Loading";
      try {
        const res = await fetch(link.href, { headers: { Accept: "text/html" } });
        if (!res.ok) throw new Error(String(res.status));
        const next = new DOMParser().parseFromString(await res.text(), "text/html");
        const grid = document.querySelector(".lot__grid");
        const have = grid ? grid.children.length : 0;
        const incoming = Array.from(next.querySelector(".lot__grid")?.children ?? []).slice(have) as unknown as HTMLElement[];
        for (const el of incoming) {
          el.classList.add("is-new");
          grid?.appendChild(el);
        }
        const box = document.querySelector("[data-more-cars]");
        const fresh = next.querySelector("[data-more-cars]");
        if (box && fresh) box.replaceWith(fresh);
        history.replaceState({ lot: true }, "", link.href);
        (incoming[0]?.querySelector("a") as HTMLAnchorElement | null)?.focus({ preventScroll: true });
      } catch {
        window.location.href = link.href;
      }
    });

    document.addEventListener("keydown", (e) => {
      const more = moreBox();
      if (e.key === "Escape" && more?.open) {
        more.open = false;
        more.querySelector("summary")?.focus();
      }
    });
    // More filters closes when you click outside it (on phones, the dimmed
    // backdrop is the details element itself).
    document.addEventListener("click", (e) => {
      const more = moreBox();
      if (more?.open && (e.target === more || !more.contains(e.target as Node))) more.open = false;
    });

    // Photo scrub: moving the pointer across a card's photo flips through its
    // first few photos (pointers that hover only).
    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      const warmed = new WeakSet<Element>();
      document.addEventListener("pointermove", (e) => {
        const box = (e.target as HTMLElement).closest?.("[data-photos]") as HTMLElement | null;
        if (!box) return;
        const img = box.querySelector("img");
        if (!img) return;
        const list = JSON.parse(box.dataset.photos ?? "[]") as string[];
        if (!warmed.has(box)) {
          warmed.add(box);
          for (const src of list.slice(1)) new Image().src = src;
        }
        const r = box.getBoundingClientRect();
        const i = Math.min(list.length - 1, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * list.length)));
        if (img.getAttribute("src") !== list[i]) img.setAttribute("src", list[i]);
        box.querySelectorAll(".car-card__dots span").forEach((d, n) => d.classList.toggle("on", n === i));
      });
      document.addEventListener(
        "pointerout",
        (e) => {
          const box = (e.target as HTMLElement).closest?.("[data-photos]") as HTMLElement | null;
          if (!box || box.contains(e.relatedTarget as Node)) return;
          const list = JSON.parse(box.dataset.photos ?? "[]") as string[];
          box.querySelector("img")?.setAttribute("src", list[0]);
          box.querySelectorAll(".car-card__dots span").forEach((d, n) => d.classList.toggle("on", n === 0));
        },
        true,
      );
    }

    // Photos fade in once loaded (and the shimmer stops).
    const markLoaded = () =>
      document.querySelectorAll(".car-card__photo img, .feature__photo img").forEach((img) => {
        if ((img as HTMLImageElement).complete) img.parentElement?.classList.add("has-img");
      });
    const onImg = (e: Event) => {
      const t = e.target as HTMLElement;
      if (t.tagName === "IMG") t.parentElement?.classList.add("has-img");
    };
    document.addEventListener("load", onImg, true);
    document.addEventListener("error", onImg, true);
    new MutationObserver(markLoaded).observe(form, { childList: true, subtree: true });
    markLoaded();

    // The filter bar gets its glass strip once it sticks under the header.
    const sentinel = document.querySelector("[data-lot-sentinel]");
    if (sentinel && "IntersectionObserver" in window) {
      const headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 64;
      const sticky = () => (matchMedia("(max-width: 720px)").matches ? 0 : headerH + 10);
      let io: IntersectionObserver | null = null;
      const watch = () => {
        io?.disconnect();
        io = new IntersectionObserver(([entry]) => form.classList.toggle("bar-stuck", !entry.isIntersecting && entry.boundingClientRect.top < sticky() + 30), {
          rootMargin: `-${sticky() + 30}px 0px 0px 0px`,
        });
        io.observe(sentinel);
      };
      watch();
      matchMedia("(max-width: 720px)").addEventListener("change", watch);
    }

    form.classList.add("is-live");
  }
</script>
