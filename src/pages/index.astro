---
// The Lot: every car for sale. A big search box with quick filters across
// the top (year, make, model, miles, price, and More filters for the rest),
// the newest arrival as a showcase, then the grid. A plain GET form, so it
// works without JavaScript and every search can be shared or bookmarked; a
// small script applies the quick filters as soon as they change.
import Base from "../layouts/Base.astro";
import { BODY_STYLES, DRIVETRAINS } from "../lib/listing-options";
import { formatMiles, formatPrice } from "../lib/listing-rules";
import { MILES, PRICES, SORTS, activeFilterCount, listedAgo, lotHref, norm, parseLotQuery, queryLot, type LotCard, type LotQuery } from "../lib/lot";
import { carUrl, url } from "../lib/paths";
import "../styles/lot.css";

const q = parseLotQuery(Astro.url.searchParams);
const lot = await queryLot(q);

type Choice = { value: string; label: string };
const moreGroups: { key: keyof LotQuery; legend: string; options: readonly Choice[]; counts: Record<string, number> }[] = [
  { key: "manual", legend: "Transmission", options: [{ value: "1", label: "Manual only" }], counts: lot.counts.manual },
  { key: "drive", legend: "Drivetrain", options: DRIVETRAINS, counts: lot.counts.drive },
  { key: "body", legend: "Body", options: BODY_STYLES, counts: lot.counts.body },
  {
    key: "seller",
    legend: "Seller",
    options: [
      { value: "private", label: "Private party" },
      { value: "dealer", label: "Specialty dealer" },
    ],
    counts: lot.counts.seller,
  },
  { key: "records", legend: "Paperwork", options: [{ value: "1", label: "Records on file" }], counts: lot.counts.records },
];
const isOn = (key: keyof LotQuery, value: string) => {
  const v = q[key];
  return Array.isArray(v) ? v.includes(value) : v === true && value === "1";
};
const moreOn = moreGroups.reduce((n, g) => n + g.options.filter((o) => isOn(g.key, o.value)).length, 0);

// Removable pills for every active filter.
const yearLabel = q.ymin !== null && q.ymax !== null ? (q.ymin === q.ymax ? `${q.ymin}` : `${q.ymin} to ${q.ymax}`) : q.ymin !== null ? `${q.ymin} and newer` : q.ymax !== null ? `${q.ymax} and older` : "";
const pills: { label: string; href: string }[] = [
  ...(yearLabel ? [{ label: yearLabel, href: lotHref(q, { ymin: null, ymax: null }) }] : []),
  ...(q.make ? [{ label: lot.makes.find((m) => norm(m.name) === norm(q.make))?.name ?? q.make, href: lotHref(q, { make: "", model: "" }) }] : []),
  ...(q.model ? [{ label: lot.models.find((m) => norm(m.name) === norm(q.model))?.name ?? q.model, href: lotHref(q, { model: "" }) }] : []),
  ...(q.miles ? [{ label: MILES.find((m) => m.value === q.miles)!.label, href: lotHref(q, { miles: "" }) }] : []),
  ...PRICES.filter((p) => q.price.includes(p.value)).map((p) => ({ label: p.label, href: lotHref(q, { price: [] }) })),
  ...moreGroups.flatMap((g) =>
    g.options
      .filter((o) => isOn(g.key, o.value))
      .map((o) => {
        const v = q[g.key];
        const without = Array.isArray(v) ? { [g.key]: v.filter((x) => x !== o.value) } : { [g.key]: false };
        return { label: o.label, href: lotHref(q, without as Partial<LotQuery>) };
      }),
  ),
];
const anyFilter = activeFilterCount(q) > 0;
const noFilters: Partial<LotQuery> = { ymin: null, ymax: null, make: "", model: "", miles: "", manual: false, records: false, price: [], drive: [], body: [], seller: [] };
const plain = !q.q && !anyFilter && q.sort === "new" && lot.page === 1;

// The newest car leads page 1 of the plain Lot when there are enough cars.
const feature: LotCard | null = plain && lot.cards.length >= 4 ? lot.cards[0] : null;
const grid = feature ? lot.cards.slice(1) : lot.cards;

const owners = (n: number | null) => (n ? `${n} ${n === 1 ? "owner" : "owners"}` : "");
const carsText = (n: number) => (n === 1 ? "1 car" : `${n.toLocaleString("en-US")} cars`);
const miles = (n: number | null) => (n === null ? "" : `${formatMiles(n)} mi`);
const facts = (c: LotCard) => [miles(c.mileage), c.transmission, c.location].filter(Boolean);
// "Just listed" for three days. Computed per request (never at module scope).
const now = Date.now();
const justListed = (c: LotCard) => c.status === "live" && !!c.publishedAt && now - c.publishedAt.getTime() < 3 * 86_400_000;
const pageTitle = q.q ? `Search: ${q.q}` : "Enthusiast cars for sale";
---

<Base
  title={pageTitle}
  index={plain}
  description="Enthusiast cars for sale by their owners. Every listing is reviewed by a person. Fixed prices and offers, no auctions."
  image={feature?.photo ? new URL(feature.photo.url, Astro.url).toString() : undefined}
>
  <h1 class="sr-only">Enthusiast cars for sale</h1>

  <form class="lot" method="get" action={url("/")} data-lot role="search">
    <div class="finder">
      <div class="finder__search">
        <label class="sr-only" for="lot-q">Search cars</label>
        <svg class="finder__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2"></circle><path
            d="M20 20l-4-4"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"></path></svg
        >
        <input
          id="lot-q"
          name="q"
          type="search"
          value={q.q}
          maxlength="80"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          placeholder="Search make, model, year or city"
        />
        <button class="btn finder__go" type="submit">Search</button>
      </div>

      <div class="quick" aria-label="Quick filters" role="group">
        <div class="qf qf--year">
          <span class="qf__label" id="qf-year">Year</span>
          <div class="qf__pair">
            <select name="ymin" aria-label="Year from" aria-describedby="qf-year">
              <option value="">From</option>
              {lot.years.map((y) => <option value={y} selected={y === q.ymin}>{y}</option>)}
            </select>
            <span class="qf__to" aria-hidden="true">to</span>
            <select name="ymax" aria-label="Year to" aria-describedby="qf-year">
              <option value="">To</option>
              {lot.years.map((y) => <option value={y} selected={y === q.ymax}>{y}</option>)}
            </select>
          </div>
        </div>
        <label class="qf">
          <span class="qf__label">Make</span>
          <select name="make" data-make>
            <option value="">All makes</option>
            {lot.makes.map((m) => <option value={m.name} selected={norm(m.name) === norm(q.make)}>{m.name} ({m.n})</option>)}
          </select>
        </label>
        <label class:list={["qf", { "is-off": !q.make }]}>
          <span class="qf__label">Model</span>
          <select id="qf-model" name="model" disabled={!q.make}>
            <option value="">{q.make ? "All models" : "Pick a make first"}</option>
            {lot.models.map((m) => <option value={m.name} selected={norm(m.name) === norm(q.model)}>{m.name} ({m.n})</option>)}
          </select>
        </label>
        <label class="qf">
          <span class="qf__label">Miles</span>
          <select name="miles">
            <option value="">Any miles</option>
            {MILES.map((m) => <option value={m.value} selected={m.value === q.miles}>{m.label} ({lot.counts.miles[m.value] ?? 0})</option>)}
          </select>
        </label>
        <label class="qf">
          <span class="qf__label">Price</span>
          <select name="price">
            <option value="">Any price</option>
            {PRICES.map((p) => <option value={p.value} selected={q.price.includes(p.value)}>{p.label} ({lot.counts.price[p.value] ?? 0})</option>)}
          </select>
        </label>

        <details class="qf qf--more" data-more>
          <summary>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M4 7h10M18 7h2M4 17h4M12 17h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><circle
                cx="16"
                cy="7"
                r="2"
                fill="none"
                stroke="currentColor"
                stroke-width="2"></circle><circle cx="10" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="2"></circle></svg
            >
            More filters
            {moreOn > 0 && <span class="count">{moreOn}</span>}
          </summary>
          <div class="more">
            <div class="more__groups">
              {
                moreGroups.map((g) => (
                  <fieldset class="more__group">
                    <legend>{g.legend}</legend>
                    {g.options.map((o) => {
                      const n = g.counts[o.value] ?? 0;
                      const on = isOn(g.key, o.value);
                      return (
                        <label class:list={["more__opt", { "is-zero": n === 0 && !on }]}>
                          <input type="checkbox" name={g.key} value={o.value} checked={on} />
                          <span>{o.label}</span>
                          <span class="more__n">{n}</span>
                        </label>
                      );
                    })}
                  </fieldset>
                ))
              }
            </div>
            <div class="more__foot">
              {anyFilter && <a class="lot__clear" href={lotHref(q, noFilters)}>Clear all filters</a>}
              <button class="btn" type="submit">Apply filters</button>
            </div>
          </div>
        </details>
        <button class="btn btn--secondary quick__apply" type="submit">Apply</button>
      </div>
    </div>

    {
      feature && (
        <a class="feature" href={carUrl(feature.slug)}>
          <div class="feature__photo">
            {feature.photo && (
              <img
                src={feature.photo.url}
                alt=""
                width={feature.photo.width ?? undefined}
                height={feature.photo.height ?? undefined}
                fetchpriority="high"
                decoding="async"
              />
            )}
          </div>
          <div class="feature__info">
            <p class="feature__eyebrow">Newest arrival</p>
            <h2 class="feature__title">{feature.title}</h2>
            {feature.headline && <p class="feature__headline">{feature.headline}</p>}
            <p class="feature__facts">{facts(feature).join("  ·  ")}</p>
            <div class="feature__foot">
              <span class="feature__price">{formatPrice(feature.price)}</span>
              <span class="btn">View this car</span>
            </div>
          </div>
        </a>
      )
    }

    <section class="lot__results" aria-labelledby="results-h">
      <div class="lot__bar">
        <h2 class="lot__count" id="results-h">{feature ? "Just in" : carsText(lot.total)}</h2>
        {feature && <span class="lot__of">{carsText(lot.total)} for sale</span>}
        <div class="lot__pills">
          {
            q.q && (
              <a class="pill" href={lotHref(q, { q: "" })} aria-label={`Remove search ${q.q}`}>
                “{q.q}” <span aria-hidden="true">✕</span>
              </a>
            )
          }
          {
            pills.map((f) => (
              <a class="pill" href={f.href} aria-label={`Remove filter ${f.label}`}>
                {f.label} <span aria-hidden="true">✕</span>
              </a>
            ))
          }
          {(q.q || anyFilter) && <a class="lot__clear" href={url("/")}>Clear all</a>}
        </div>
        <label class="lot__sort">
          <span class="lot__sort-label">Sort</span>
          <select name="sort">
            {SORTS.map((s) => <option value={s.value} selected={s.value === q.sort}>{s.label}</option>)}
          </select>
        </label>
      </div>

      {
        lot.cards.length === 0 ? (
          <div class="lot__empty card">
            {lot.lotSize === 0 ? (
              <>
                <h2>No cars on the Lot yet</h2>
                <p>Every car here is reviewed by a person before it goes live. Be one of the first to list yours.</p>
                <a class="btn" href={url("/sell")}>
                  Sell your car
                </a>
              </>
            ) : (
              <>
                <h2>No cars match {q.q ? `“${q.q}”` : "these filters"}</h2>
                <p>Try fewer filters or a shorter search.</p>
                <a class="btn" href={url("/")}>
                  Clear search and filters
                </a>
              </>
            )}
          </div>
        ) : (
          <ul class="lot__grid" role="list">
            {grid.map((c, i) => (
              <li>
                <a class="car-card" href={carUrl(c.slug)}>
                  <div class="car-card__photo">
                    {c.photo && (
                      <img
                        src={c.photo.url}
                        alt=""
                        width={c.photo.width ?? undefined}
                        height={c.photo.height ?? undefined}
                        loading={i < 6 ? "eager" : "lazy"}
                        decoding="async"
                      />
                    )}
                    {c.status === "offer_accepted" ? (
                      <span class="car-card__flag car-card__flag--dark">Offer accepted</span>
                    ) : justListed(c) ? (
                      <span class="car-card__flag">Just listed</span>
                    ) : null}
                    <span class="car-card__price">{formatPrice(c.price)}</span>
                    {c.photoCount > 0 && (
                      <span class="car-card__count">
                        <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M4 8h3l2-3h6l2 3h3v11H4z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linejoin="round"
                          />
                          <circle cx="12" cy="13" r="3.2" fill="none" stroke="currentColor" stroke-width="2" />
                        </svg>
                        {c.photoCount}
                        <span class="sr-only"> photos</span>
                      </span>
                    )}
                  </div>
                  <div class="car-card__body">
                    <h3 class="car-card__title">{c.title}</h3>
                    {c.headline && <p class="car-card__headline">{c.headline}</p>}
                    <p class="car-card__facts">
                      {facts(c).map((f) => (
                        <span>{f}</span>
                      ))}
                    </p>
                    <div class="car-card__meta">
                      <span class="car-card__badges">
                        {c.recordsOnFile && <span class="badge badge--ok">Records</span>}
                        {c.ownerCount ? <span class="badge">{owners(c.ownerCount)}</span> : null}
                        {c.acceptsOffers && c.status === "live" && <span class="badge">Offers</span>}
                        {c.verifiedSeller && <span class="badge">Verified seller</span>}
                      </span>
                      <span class="car-card__ago">{listedAgo(c.publishedAt)}</span>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        lot.pages > 1 && (
          <nav class="lot__pages" aria-label="Pages">
            {lot.page > 1 ? (
              <a class="btn btn--secondary" href={lotHref(q, { page: lot.page - 1 })} rel="prev">
                Previous
              </a>
            ) : (
              <span />
            )}
            <span class="lot__page-n">
              Page {lot.page} of {lot.pages}
            </span>
            {lot.page < lot.pages ? (
              <a class="btn btn--secondary" href={lotHref(q, { page: lot.page + 1 })} rel="next">
                Next
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </section>
  </form>
</Base>

<script>
  // The quick filters and sort apply as soon as they change; More filters
  // applies with its button. Without this script the Apply buttons submit.
  const form = document.querySelector<HTMLFormElement>("[data-lot]");
  const more = document.querySelector<HTMLDetailsElement>("[data-more]");
  if (form) {
    form.classList.add("is-live");
    // Only send the fields that are set, so the address stays short.
    form.addEventListener("formdata", (e) => {
      const keep = [...e.formData.entries()].filter(([k, v]) => v !== "" && !(k === "sort" && v === "new"));
      for (const k of new Set([...e.formData.keys()])) e.formData.delete(k);
      for (const [k, v] of keep) e.formData.append(k, v);
    });
    form.addEventListener("change", (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === "q" || t.type === "checkbox") return;
      // A new make starts with all of its models.
      if (t.name === "make") {
        const model = document.getElementById("qf-model") as HTMLSelectElement | null;
        if (model) model.value = "";
      }
      form.requestSubmit();
    });
    // "/" jumps to the search box.
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (e.key === "/" && !e.ctrlKey && !e.metaKey && !/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) && !t.isContentEditable) {
        e.preventDefault();
        document.getElementById("lot-q")?.focus();
      }
      if (e.key === "Escape" && more?.open) {
        more.open = false;
        more.querySelector("summary")?.focus();
      }
    });
    // More filters closes when you click outside it.
    document.addEventListener("click", (e) => {
      if (more?.open && !more.contains(e.target as Node)) more.open = false;
    });
  }
</script>
